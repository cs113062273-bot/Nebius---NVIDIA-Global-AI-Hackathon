          "maxTabs": 24
        },
        "assertions": []
      },
      {
        "title": "Move forward to the next available date, skipping closed weekends",
        "action": {
          "kind": "press",
          "key": "ArrowRight"
        },
        "assertions": []
      },
      {
        "title": "Reach Save",
        "action": {
          "kind": "seek",
          "selector": "#save",
          "maxTabs": 24
        },
        "assertions": []
      },
      {
        "title": "Save booking dates",
