{
  "journey": {
    "version": 1,
    "id": "historical-dialog-keyboard",
    "title": "Restore focus after closing a real dialog",
    "goal": "Focus returns to the opener",
    "source": "authored",
    "profile": "keyboard",
    "path": "/",
    "steps": [
      {
        "title": "Reach notice trigger",
        "action": {
          "kind": "seek",
          "selector": "#open"
        }
      },
      {
        "title": "Open notice",
        "action": {
          "kind": "press",
          "key": "Enter"
        },
        "assertions": [
          {
            "kind": "focus",
            "selector": "#dialog"
          }
        ]
      },
      {
        "title": "Dismiss notice and return to the opener",
        "action": {
          "kind": "press",
          "key": "Escape"
        },
        "assertions": [
          {
            "kind": "focus",
            "selector": "#open"
          }
        ]
      }
    ],
    "success": [
      {
        "kind": "focus",
        "selector": "#open"
      }
    ],
    "functional": [
      {
        "kind": "attribute",
        "selector": "#dialog",
        "name": "aria-hidden",
        "value": "true"
      }
    ],
    "forbidden": []
  },
  "functionalJourney": {
    "version": 1,
    "id": "historical-dialog-pointer",
    "title": "Restore focus after closing a real dialog",
    "goal": "Focus returns to the opener",
    "source": "authored",
    "profile": "pointer",
    "path": "/",
    "steps": [
      {
        "title": "Open notice",
        "action": {
          "kind": "click",
          "selector": "#open"
        },
        "assertions": [
          {
            "kind": "attribute",
            "selector": "#dialog",
            "name": "aria-hidden",
            "value": null
          }
        ]
      },
      {
        "title": "Close notice with pointer",
        "action": {
          "kind": "click",
          "selector": "#close"
        },
        "assertions": [
          {
            "kind": "attribute",
            "selector": "#dialog",
            "name": "aria-hidden",
            "value": "true"
          }
        ]
      }
    ],
    "success": [
      {
        "kind": "attribute",
        "selector": "#dialog",
        "name": "aria-hidden",
        "value": "true"
      }
    ],
    "functional": [
      {
        "kind": "attribute",
        "selector": "#dialog",
        "name": "aria-hidden",
        "value": "true"
      }
    ],
    "forbidden": []
  },
  "guards": []
}
