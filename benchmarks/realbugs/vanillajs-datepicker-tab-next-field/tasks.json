{
  "journey": {
    "version": 1, "id": "datepicker-tab-to-next-field", "title": "Tab out of the visit date into the access notes",
    "goal": "Pressing Tab in the open date field moves focus to the next form field so the user can keep typing",
    "source": "authored", "profile": "keyboard", "path": "/",
    "steps": [
      {"title": "Reach the visit date field", "action": {"kind": "seek", "selector": "#visit-date"},
       "assertions": [{"kind": "focus", "selector": "#visit-date"}]},
      {"title": "Tab to the next field", "action": {"kind": "press", "key": "Tab"},
       "assertions": [{"kind": "focus", "selector": "#notes"}]},
      {"title": "Type access notes", "action": {"kind": "type", "text": "Use the side gate"},
       "assertions": [{"kind": "form-data", "selector": "#visit-form", "name": "notes", "value": ["Use the side gate"]}]}
    ],
    "success": [{"kind": "focus", "selector": "#notes"}, {"kind": "form-data", "selector": "#visit-form", "name": "notes", "value": ["Use the side gate"]}],
    "functional": [{"kind": "form-data", "selector": "#visit-form", "name": "visit", "value": ["2024-03-15"]}],
    "forbidden": []
  },
  "functionalJourney": {
    "version": 1, "id": "datepicker-pointer-pick", "title": "Pick a visit date with the pointer",
    "goal": "Clicking a day in the calendar fills the visit date field",
    "source": "authored", "profile": "pointer", "path": "/",
    "steps": [
      {"title": "Open the calendar", "action": {"kind": "click", "selector": "#visit-date"},
       "assertions": [{"kind": "visible", "selector": ".datepicker-picker", "value": true}]},
      {"title": "Choose 20 March", "action": {"kind": "click", "selector": ".datepicker-cell[data-date=\"1710892800000\"]"},
       "assertions": [{"kind": "form-data", "selector": "#visit-form", "name": "visit", "value": ["2024-03-20"]}]},
      {"title": "Submit the request", "action": {"kind": "click", "selector": "#submit"},
       "assertions": [{"kind": "text", "selector": "#status", "value": "Requested 2024-03-20"}]}
    ],
    "success": [{"kind": "text", "selector": "#status", "value": "Requested 2024-03-20"}],
    "functional": [{"kind": "form-data", "selector": "#visit-form", "name": "visit", "value": ["2024-03-20"]}],
    "forbidden": []
  },
  "guards": [
    {
      "version": 1, "id": "datepicker-keyboard-pick", "title": "Pick the next day with arrow keys",
      "goal": "Arrow keys move the calendar focus and Enter commits the date",
      "source": "authored", "profile": "keyboard", "path": "/",
      "steps": [
        {"title": "Reach the visit date field", "action": {"kind": "seek", "selector": "#visit-date"}},
        {"title": "Move to the next day", "action": {"kind": "press", "key": "ArrowRight"}},
        {"title": "Commit the day", "action": {"kind": "press", "key": "Enter"},
         "assertions": [{"kind": "form-data", "selector": "#visit-form", "name": "visit", "value": ["2024-03-16"]}]}
      ],
      "success": [{"kind": "form-data", "selector": "#visit-form", "name": "visit", "value": ["2024-03-16"]}, {"kind": "focus", "selector": "#visit-date"}],
      "functional": [{"kind": "form-data", "selector": "#visit-form", "name": "visit", "value": ["2024-03-16"]}],
      "forbidden": []
    }
  ]
}
