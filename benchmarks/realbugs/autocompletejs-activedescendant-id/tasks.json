{
  "journey": {
    "version": 1, "id": "autocomplete-active-option-reference", "title": "Arrow through store suggestions with the active option announced",
    "goal": "While arrowing through suggestions, the input's aria-activedescendant names the highlighted option element",
    "source": "authored", "profile": "keyboard", "path": "/",
    "steps": [
      {"title": "Reach the store field", "action": {"kind": "seek", "selector": "#store"}},
      {"title": "Type ma", "action": {"kind": "type", "text": "ma"},
       "assertions": [{"kind": "text", "selector": "#autoCompleteJS_result_1", "value": "Marina Park"}]},
      {"title": "Highlight the first suggestion", "action": {"kind": "press", "key": "ArrowDown"},
       "assertions": [{"kind": "attribute", "selector": "#autoCompleteJS_result_0", "name": "aria-selected", "value": "true"},
                      {"kind": "attribute", "selector": "#store", "name": "aria-activedescendant", "value": "autoCompleteJS_result_0"}]},
      {"title": "Highlight the second suggestion", "action": {"kind": "press", "key": "ArrowDown"},
       "assertions": [{"kind": "attribute", "selector": "#autoCompleteJS_result_1", "name": "aria-selected", "value": "true"},
                      {"kind": "attribute", "selector": "#store", "name": "aria-activedescendant", "value": "autoCompleteJS_result_1"}]},
      {"title": "Choose it", "action": {"kind": "press", "key": "Enter"},
       "assertions": [{"kind": "form-data", "selector": "#pickup-form", "name": "store", "value": ["Marina Park"]}]}
    ],
    "success": [{"kind": "form-data", "selector": "#pickup-form", "name": "store", "value": ["Marina Park"]}],
    "functional": [{"kind": "form-data", "selector": "#pickup-form", "name": "store", "value": ["Marina Park"]}],
    "forbidden": []
  },
  "functionalJourney": {
    "version": 1, "id": "autocomplete-store-pointer-pick", "title": "Choose a pickup store with the pointer",
    "goal": "Clicking a suggestion fills the store field",
    "source": "authored", "profile": "pointer", "path": "/",
    "steps": [
      {"title": "Focus the store field", "action": {"kind": "click", "selector": "#store"}},
      {"title": "Type ma", "action": {"kind": "type", "text": "ma"},
       "assertions": [{"kind": "text", "selector": "#autoCompleteJS_result_2", "value": "Maple Avenue"}]},
      {"title": "Click Maple Avenue", "action": {"kind": "click", "selector": "#autoCompleteJS_result_2"},
       "assertions": [{"kind": "form-data", "selector": "#pickup-form", "name": "store", "value": ["Maple Avenue"]}]},
      {"title": "Confirm", "action": {"kind": "click", "selector": "#submit"},
       "assertions": [{"kind": "text", "selector": "#status", "value": "Pickup at Maple Avenue"}]}
    ],
    "success": [{"kind": "text", "selector": "#status", "value": "Pickup at Maple Avenue"}],
    "functional": [{"kind": "form-data", "selector": "#pickup-form", "name": "store", "value": ["Maple Avenue"]}],
    "forbidden": []
  },
  "guards": [
    {
      "version": 1, "id": "autocomplete-store-arrow-up-wrap", "title": "Arrow up from the field to the last suggestion",
      "goal": "ArrowUp wraps to the last suggestion and Enter chooses it",
      "source": "authored", "profile": "keyboard", "path": "/",
      "steps": [
        {"title": "Reach the store field", "action": {"kind": "seek", "selector": "#store"}},
        {"title": "Type ma", "action": {"kind": "type", "text": "ma"}},
        {"title": "Wrap to the last suggestion", "action": {"kind": "press", "key": "ArrowUp"}},
        {"title": "Choose it", "action": {"kind": "press", "key": "Enter"}}
      ],
      "success": [{"kind": "form-data", "selector": "#pickup-form", "name": "store", "value": ["Harbour Mall"]}],
      "functional": [{"kind": "form-data", "selector": "#pickup-form", "name": "store", "value": ["Harbour Mall"]}],
      "forbidden": []
    }
  ]
}
