{
  "journey": {
    "version": 1, "id": "datepicker-invalid-text-tab-away", "title": "Tab away after typing an unavailable delivery date",
    "goal": "Leaving the date field with Tab closes the calendar even when the typed date is outside the delivery window",
    "source": "authored", "profile": "keyboard", "path": "/",
    "steps": [
      {"title": "Reach the delivery date field", "action": {"kind": "seek", "selector": "#delivery-date"},
       "assertions": [{"kind": "visible", "selector": ".datepicker", "value": true}]},
      {"title": "Type a date outside the delivery window", "action": {"kind": "type", "text": "2024-07-15", "replace": true}},
      {"title": "Tab to the instructions", "action": {"kind": "press", "key": "Tab"},
       "assertions": [{"kind": "focus", "selector": "#instructions"}, {"kind": "visible", "selector": ".datepicker", "value": false}]}
    ],
    "success": [{"kind": "visible", "selector": ".datepicker", "value": false}, {"kind": "focus", "selector": "#instructions"}],
    "functional": [{"kind": "focus", "selector": "#instructions"}],
    "forbidden": []
  },
  "functionalJourney": {
    "version": 1, "id": "datepicker-pointer-next-month", "title": "Move the delivery into June with the pointer",
    "goal": "Clicking through the calendar to June and choosing a day fills the delivery date",
    "source": "authored", "profile": "pointer", "path": "/",
    "steps": [
      {"title": "Open the calendar", "action": {"kind": "click", "selector": "#delivery-date"},
       "assertions": [{"kind": "visible", "selector": ".datepicker", "value": true}]},
      {"title": "Go to June", "action": {"kind": "click", "selector": ".datepicker .next-btn"}},
      {"title": "Choose 4 June", "action": {"kind": "click", "selector": ".datepicker-cell[data-date=\"1717459200000\"]"},
       "assertions": [{"kind": "form-data", "selector": "#delivery-form", "name": "delivery", "value": ["2024-06-04"]}]},
      {"title": "Save", "action": {"kind": "click", "selector": "#submit"},
       "assertions": [{"kind": "text", "selector": "#status", "value": "Delivery set for 2024-06-04"}]}
    ],
    "success": [{"kind": "text", "selector": "#status", "value": "Delivery set for 2024-06-04"}],
    "functional": [{"kind": "form-data", "selector": "#delivery-form", "name": "delivery", "value": ["2024-06-04"]}],
    "forbidden": []
  },
  "guards": [
    {
      "version": 1, "id": "datepicker-typed-date-tab-away", "title": "Type a valid delivery date and Tab away",
      "goal": "A correctly typed date is committed and the calendar closes when the user tabs away",
      "source": "authored", "profile": "keyboard", "path": "/",
      "steps": [
        {"title": "Reach the delivery date field", "action": {"kind": "seek", "selector": "#delivery-date"}},
        {"title": "Type a new date", "action": {"kind": "type", "text": "2024-05-21", "replace": true}},
        {"title": "Tab to the instructions", "action": {"kind": "press", "key": "Tab"},
         "assertions": [{"kind": "form-data", "selector": "#delivery-form", "name": "delivery", "value": ["2024-05-21"]}]}
      ],
      "success": [{"kind": "form-data", "selector": "#delivery-form", "name": "delivery", "value": ["2024-05-21"]}, {"kind": "visible", "selector": ".datepicker", "value": false}, {"kind": "focus", "selector": "#instructions"}],
      "functional": [{"kind": "form-data", "selector": "#delivery-form", "name": "delivery", "value": ["2024-05-21"]}],
      "forbidden": []
    }
  ]
}
