    "steps": [
      {"title": "Open basket", "action": {"kind": "click", "selector": "#open"}, "assertions": [{"kind": "visible", "selector": "#basket", "value": true}]},
      {"title": "Remove pruning shears", "action": {"kind": "click", "selector": "#remove-2"}, "assertions": [{"kind": "text", "selector": "#count", "value": "2 items"}]},
      {"title": "Close basket", "action": {"kind": "click", "selector": "#close"}, "assertions": [{"kind": "visible", "selector": "#basket", "value": false}]}
    ],
    "success": [{"kind": "visible", "selector": "#basket", "value": false}],
    "functional": [{"kind": "text", "selector": "#count", "value": "2 items"}, {"kind": "visible", "selector": "#basket", "value": false}],
    "forbidden": []
  },
  "guards": [
    {
      "version": 1, "id": "focus-trap-ancestor-wrap", "title": "Tab wraps inside the basket",
      "goal": "Tab from the last Remove button returns to the close button", "source": "authored", "profile": "keyboard", "path": "/",
      "steps": [
