      {"title": "Move to the first Remove button", "action": {"kind": "press", "key": "Tab"}, "assertions": [{"kind": "focus", "selector": "#remove-1"}]},
      {"title": "Remove the hand trowel", "action": {"kind": "press", "key": "Enter"}, "assertions": [{"kind": "text", "selector": "#count", "value": "2 items"}, {"kind": "visible", "selector": "#basket:focus-within", "value": true}]}
    ],
    "success": [{"kind": "visible", "selector": "#basket:focus-within", "value": true}, {"kind": "visible", "selector": "#basket", "value": true}],
    "functional": [{"kind": "text", "selector": "#count", "value": "2 items"}],
    "forbidden": []
  },
  "functionalJourney": {
