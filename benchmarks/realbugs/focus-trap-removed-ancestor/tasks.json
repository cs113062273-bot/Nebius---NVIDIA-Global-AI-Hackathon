        {"title": "Move backwards to the last Remove button", "action": {"kind": "press", "key": "Shift+Tab"}, "assertions": [{"kind": "focus", "selector": "#remove-3"}]},
        {"title": "Wrap forwards", "action": {"kind": "press", "key": "Tab"}, "assertions": [{"kind": "focus", "selector": "#close"}]}
      ],
      "success": [{"kind": "focus", "selector": "#close"}],
      "functional": [{"kind": "text", "selector": "#count", "value": "3 items"}],
