{
  "journey": {
    "version": 1, "id": "autocomplete-refine-then-enter", "title": "Refine the search and choose the highlighted fruit with Enter",
    "goal": "After the suggestions are refined, Enter selects the suggestion that is highlighted",
    "source": "authored", "profile": "keyboard", "path": "/",
    "steps": [
      {"title": "Reach the fruit field", "action": {"kind": "seek", "selector": "#fruit"}},
      {"title": "Type b", "action": {"kind": "type", "text": "b"},
       "assertions": [{"kind": "attribute", "selector": "#fruit", "name": "aria-expanded", "value": "true"}]},
      {"title": "Move down the suggestions", "action": {"kind": "press", "key": "ArrowDown"}},
      {"title": "Move down again", "action": {"kind": "press", "key": "ArrowDown"},
       "assertions": [{"kind": "attribute", "selector": "#autoComplete_result_1", "name": "aria-selected", "value": "true"}]},
      {"title": "Refine to bl", "action": {"kind": "type", "text": "l"},
       "assertions": [{"kind": "text", "selector": "#autoComplete_result_0", "value": "Blackberry"}]},
      {"title": "Highlight the first refined suggestion", "action": {"kind": "press", "key": "ArrowDown"},
       "assertions": [{"kind": "attribute", "selector": "#autoComplete_result_0", "name": "aria-selected", "value": "true"}]},
      {"title": "Choose the highlighted suggestion", "action": {"kind": "press", "key": "Enter"},
       "assertions": [{"kind": "form-data", "selector": "#order-form", "name": "fruit", "value": ["Blackberry"]}]}
    ],
    "success": [{"kind": "form-data", "selector": "#order-form", "name": "fruit", "value": ["Blackberry"]}],
    "functional": [{"kind": "focus", "selector": "#fruit"}],
    "forbidden": []
  },
  "functionalJourney": {
    "version": 1, "id": "autocomplete-pointer-pick", "title": "Choose a fruit with the pointer",
    "goal": "Clicking a suggestion fills the fruit field",
    "source": "authored", "profile": "pointer", "path": "/",
    "steps": [
      {"title": "Focus the fruit field", "action": {"kind": "click", "selector": "#fruit"}},
      {"title": "Type bl", "action": {"kind": "type", "text": "bl"},
       "assertions": [{"kind": "text", "selector": "#autoComplete_result_2", "value": "Blueberry"}]},
      {"title": "Click Blueberry", "action": {"kind": "click", "selector": "#autoComplete_result_2"},
       "assertions": [{"kind": "form-data", "selector": "#order-form", "name": "fruit", "value": ["Blueberry"]}]},
      {"title": "Add to order", "action": {"kind": "click", "selector": "#submit"},
       "assertions": [{"kind": "text", "selector": "#status", "value": "Added Blueberry"}]}
    ],
    "success": [{"kind": "text", "selector": "#status", "value": "Added Blueberry"}],
    "functional": [{"kind": "form-data", "selector": "#order-form", "name": "fruit", "value": ["Blueberry"]}],
    "forbidden": []
  },
  "guards": [
    {
      "version": 1, "id": "autocomplete-keyboard-pick", "title": "Choose the second suggestion with arrow keys",
      "goal": "ArrowDown twice and Enter selects the second suggestion",
      "source": "authored", "profile": "keyboard", "path": "/",
      "steps": [
        {"title": "Reach the fruit field", "action": {"kind": "seek", "selector": "#fruit"}},
        {"title": "Type bl", "action": {"kind": "type", "text": "bl"}},
        {"title": "Move down", "action": {"kind": "press", "key": "ArrowDown"}},
        {"title": "Move down again", "action": {"kind": "press", "key": "ArrowDown"},
         "assertions": [{"kind": "attribute", "selector": "#autoComplete_result_1", "name": "aria-selected", "value": "true"}]},
        {"title": "Choose it", "action": {"kind": "press", "key": "Enter"},
         "assertions": [{"kind": "form-data", "selector": "#order-form", "name": "fruit", "value": ["Blackcurrant"]}]}
      ],
      "success": [{"kind": "form-data", "selector": "#order-form", "name": "fruit", "value": ["Blackcurrant"]}],
      "functional": [{"kind": "form-data", "selector": "#order-form", "name": "fruit", "value": ["Blackcurrant"]}],
      "forbidden": []
    }
  ]
}
