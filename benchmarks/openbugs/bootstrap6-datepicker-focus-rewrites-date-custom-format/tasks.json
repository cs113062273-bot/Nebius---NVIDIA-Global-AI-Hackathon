{
 "journey": {
  "version": 1,
  "id": "bs6-datepicker-leave-keeps-date",
  "title": "Leave the saved departure date untouched and change the passengers",
  "goal": "Moving through the date field without picking a date leaves the submitted departure date unchanged",
  "source": "authored",
  "profile": "keyboard",
  "path": "/",
  "steps": [
   {
    "title": "Reach the departure date",
    "action": {
     "kind": "seek",
     "selector": "#departure"
    }
   },
   {
    "title": "Close the calendar without picking",
    "action": {
     "kind": "press",
     "key": "Escape"
    }
   },
   {
    "title": "Reach passengers",
    "action": {
     "kind": "seek",
     "selector": "#passengers"
    }
   },
   {
    "title": "Change the passengers",
    "action": {
     "kind": "type",
     "text": "2",
     "replace": true
    }
   },
   {
    "title": "Reach Save changes",
    "action": {
     "kind": "seek",
     "selector": "#save"
    }
   },
   {
    "title": "Save",
    "action": {
     "kind": "press",
     "key": "Enter"
    }
   }
  ],
  "success": [
   {
    "kind": "text",
    "selector": "#sent",
    "value": "departure=2026-10-22&passengers=2"
   }
  ],
  "functional": [
   {
    "kind": "form-data",
    "selector": "#booking",
    "name": "departure",
    "value": [
     "2026-10-22"
    ]
   }
  ],
  "forbidden": []
 },
 "functionalJourney": {
  "version": 1,
  "id": "bs6-datepicker-pointer-passengers",
  "title": "Change the passengers with the pointer",
  "goal": "Editing another field and saving submits the saved departure date",
  "source": "authored",
  "profile": "pointer",
  "path": "/",
  "steps": [
   {
    "title": "Click passengers",
    "action": {
     "kind": "click",
     "selector": "#passengers"
    }
   },
   {
    "title": "Change the passengers",
    "action": {
     "kind": "type",
     "text": "3",
     "replace": true
    }
   },
   {
    "title": "Save",
    "action": {
     "kind": "click",
     "selector": "#save"
    }
   }
  ],
  "success": [
   {
    "kind": "text",
    "selector": "#sent",
    "value": "departure=2026-10-22&passengers=3"
   }
  ],
  "functional": [
   {
    "kind": "form-data",
    "selector": "#booking",
    "name": "departure",
    "value": [
     "2026-10-22"
    ]
   }
  ],
  "forbidden": []
 },
 "guards": [
  {
   "version": 1,
   "id": "bs6-datepicker-configured-format",
   "title": "A picked date still shows in the configured dateFormat",
   "goal": "Picking 25 October in a datepicker configured with a long date format shows \"October 25, 2026\"",
   "source": "authored",
   "profile": "pointer",
   "path": "/",
   "steps": [
    {
     "title": "Open the return date",
     "action": {
      "kind": "click",
      "selector": "#return"
     }
    },
    {
     "title": "Pick 25 October",
     "action": {
      "kind": "click",
      "selector": "[data-vc-date=\"2026-10-25\"] button"
     }
    },
    {
     "title": "Save",
     "action": {
      "kind": "click",
      "selector": "#save"
     }
    }
   ],
   "success": [
    {
     "kind": "text",
     "selector": "#return-shown",
     "value": "October 25, 2026"
    }
   ],
   "functional": [
    {
     "kind": "text",
     "selector": "#return-shown",
     "value": "October 25, 2026"
    }
   ],
   "forbidden": []
  }
 ]
}
