{
  "journey": {
    "version": 1,
    "id": "bs6-dialog-escape-ignored",
    "title": "Escape must not dismiss a dialog opened with keyboard: false",
    "goal": "The confirmation dialog stays open however often Escape is pressed, so the user can still enter the code and send the transfer",
    "source": "authored",
    "profile": "keyboard",
    "path": "/",
    "steps": [
      {
        "title": "Reach Confirm transfer",
        "action": {
          "kind": "seek",
          "selector": "#confirm-open"
        }
      },
      {
        "title": "Open the confirmation",
        "action": {
          "kind": "press",
          "key": "Enter"
        },
        "assertions": [
          {
            "kind": "focus",
            "selector": "#otp"
          }
        ]
      },
      {
        "title": "Press Escape",
        "action": {
          "kind": "press",
          "key": "Escape"
        },
        "assertions": [
          {
            "kind": "attribute",
            "selector": "#confirm-dialog",
            "name": "open",
            "value": ""
          },
          {
            "kind": "focus",
            "selector": "#otp"
          }
        ]
      },
      {
        "title": "Press Escape again",
        "action": {
          "kind": "press",
          "key": "Escape"
        },
        "assertions": [
          {
            "kind": "attribute",
            "selector": "#confirm-dialog",
            "name": "open",
            "value": ""
          }
        ]
      },
      {
        "title": "Press Escape a third time",
        "action": {
          "kind": "press",
          "key": "Escape"
        },
        "assertions": [
          {
            "kind": "attribute",
            "selector": "#confirm-dialog",
            "name": "open",
            "value": ""
          }
        ]
      },
      {
        "title": "Enter the code",
        "action": {
          "kind": "type",
          "text": "482913"
        }
      },
      {
        "title": "Move to Send",
        "action": {
          "kind": "press",
          "key": "Tab"
        }
      },
      {
        "title": "Move to Send",
        "action": {
          "kind": "press",
          "key": "Tab"
        },
        "assertions": [
          {
            "kind": "focus",
            "selector": "#send"
          }
        ]
      },
      {
        "title": "Send the transfer",
        "action": {
          "kind": "press",
          "key": "Enter"
        }
      }
    ],
    "success": [
      {
        "kind": "text",
        "selector": "#status",
        "value": "Sent"
      }
    ],
    "functional": [
      {
        "kind": "attribute",
        "selector": "#confirm-dialog",
        "name": "open",
        "value": null
      }
    ],
    "forbidden": []
  },
  "functionalJourney": {
    "version": 1,
    "id": "bs6-dialog-pointer-send",
    "title": "Confirm with the pointer",
    "goal": "Clicking the backdrop does not close the dialog; entering the code and clicking Send completes the transfer",
    "source": "authored",
    "profile": "pointer",
    "path": "/",
    "steps": [
      {
        "title": "Open the confirmation",
        "action": {
          "kind": "click",
          "selector": "#confirm-open"
        }
      },
      {
        "title": "Type the code",
        "action": {
          "kind": "type",
          "text": "482913"
        }
      },
      {
        "title": "Send",
        "action": {
          "kind": "click",
          "selector": "#send"
        }
      }
    ],
    "success": [
      {
        "kind": "text",
        "selector": "#status",
        "value": "Sent"
      }
    ],
    "functional": [
      {
        "kind": "attribute",
        "selector": "#confirm-dialog",
        "name": "open",
        "value": null
      }
    ],
    "forbidden": []
  },
  "guards": [
    {
      "version": 1,
      "id": "bs6-dialog-explicit-cancel",
      "title": "Cancel transfer still closes the dialog from the keyboard",
      "goal": "Tabbing to Cancel transfer and pressing Enter closes the dialog and records the cancellation",
      "source": "authored",
      "profile": "keyboard",
      "path": "/",
      "steps": [
        {
          "title": "Reach Confirm transfer",
          "action": {
            "kind": "seek",
            "selector": "#confirm-open"
          }
        },
        {
          "title": "Open the confirmation",
          "action": {
            "kind": "press",
            "key": "Enter"
          }
        },
        {
          "title": "Move to Cancel transfer",
          "action": {
            "kind": "press",
            "key": "Tab"
          },
          "assertions": [
            {
              "kind": "focus",
              "selector": "#cancel-transfer"
            }
          ]
        },
        {
          "title": "Cancel",
          "action": {
            "kind": "press",
            "key": "Enter"
          }
        }
      ],
      "success": [
        {
          "kind": "text",
          "selector": "#status",
          "value": "Cancelled"
        }
      ],
      "functional": [
        {
          "kind": "attribute",
          "selector": "#confirm-dialog",
          "name": "open",
          "value": null
        }
      ],
      "forbidden": []
    }
  ]
}