HOST=127.0.0.1
PORT=4317
LIVE_NEBIUS_TESTS=false
NEBIUS_API_KEY=
# Choose an NVIDIA Nemotron ID returned by npm run live:catalog.
NEBIUS_MODEL=
# Must be explicitly true only after confirming sponsor/free credits and no overage billing.
NEBIUS_SPONSOR_CREDITS_CONFIRMED=false
NEBIUS_MAX_CALLS=6
NEBIUS_MAX_TOTAL_TOKENS=30000
# Optional dollar ceiling against live catalog prices; unknown prices fail closed.
NEBIUS_MAX_CREDIT_USD=
NEBIUS_BUDGET_SCOPE=default
NEBIUS_MAX_OUTPUT_TOKENS=3000
# Optional; sent as reasoning_effort only when set (e.g. low). Leave empty if the model rejects it.
NEBIUS_REASONING_EFFORT=
NEBIUS_TIMEOUT_MS=120000
# Public mode only accepts bundled fixtures. An authentication token is required for writes.
PUBLIC_DEMO=false
DEMO_TOKEN=
