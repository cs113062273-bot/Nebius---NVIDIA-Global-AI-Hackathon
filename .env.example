HOST=127.0.0.1
PORT=4317
LIVE_NEBIUS_TESTS=false
NEBIUS_API_KEY=
# Choose an NVIDIA Nemotron ID returned by npm run live:smoke (catalog mode).
NEBIUS_MODEL=
# Must be explicitly true only after confirming sponsor/free credits and no overage billing.
NEBIUS_SPONSOR_CREDITS_CONFIRMED=false
NEBIUS_MAX_CALLS=6
NEBIUS_MAX_TOTAL_TOKENS=30000
NEBIUS_MAX_OUTPUT_TOKENS=3000
# Public mode only accepts bundled fixtures. An authentication token is required for writes.
PUBLIC_DEMO=false
DEMO_TOKEN=
