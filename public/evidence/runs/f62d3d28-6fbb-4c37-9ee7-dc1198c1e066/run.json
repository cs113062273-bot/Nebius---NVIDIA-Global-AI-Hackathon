le":"Arrow past a disabled settings tab","goal":"ArrowRight skips the disabled tab and selects the next enabled one","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the Account tab","action":{"kind":"seek","selector":"#tab-account","maxTabs":24},"assertions":[]},{"title":"Move right past the disabled Notifications tab","action":{"kind":"press","key":"ArrowRight"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"focus","selector":"#tab-billing"}]}],"success":[{"kind":"focus","selector":"#tab-billing"},{"kind":"visible","selector":"#billing-plan","value":true}],"functional":[{"kind":"attribute","selector":"#tab-notifications","name":"aria-selected","value":"false"},{"kind":"visible","selector":"#notify-email","value":false}],"forbidden":[]},"functionalJourney":{"version":1,"id":"bootstrap-tabs-disabled-pointer","title":"Switch settings sections with the mouse","goal":"Clicking a tab shows its panel","source":"authored","profile":"pointer","path":"/","steps":[{"title":"Open Billing","action":{"kind":"click","selector":"#tab-billing"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":true}]},{"title":"Return to Account","action":{"kind":"click","selector":"#tab-account"},"assertions":[{"kind":"attribute","selector":"#tab-account","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#account-name","value":true}]}],"success":[{"kind":"visible","selector":"#account-name","value":true}],"functional":[{"kind":"attribute","selector":"#tab-account","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":false}],"forbidden":[]},"guards":[{"version":1,"id":"bootstrap-tabs-disabled-left-guard","title":"Arrow left wraps to the last tab","goal":"ArrowLeft from the first tab selects Billing","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the Account tab","action":{"kind":"seek","selector":"#tab-account","maxTabs":24},"assertions":[]},{"title":"Wrap left to Billing","action":{"kind":"press","key":"ArrowLeft"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"focus","selector":"#tab-billing"}]}],"success":[{"kind":"focus","selector":"#tab-billing"}],"functional":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":true}],"forbidden":[]}],"guardsHash":"ebea33ab19683c1fe77d44af60b14e7b204f03737fe60c6814a719cad0ec1288","attempts":[{"attempt":1,"startedAt":"2026-10-26T13:12:34.386Z","verified":true,"category":null,"plan":{"root_cause":"The _keydown handler in tab.js uses getNextActiveElement without checking whether the target tab is disabled, allowing focus to move to a disabled tab when arrow keys are pressed.","repair_strategy":"Modify the _keydown method to skip over disabled tabs by repeatedly calling getNextActiveElement in the navigation direction until an enabled tab is found or a safe iteration limit is reached.","edits":[{"path":"js/src/tab.js","sha256":"7ad4e9f0424d0d4b95bcf399a1639e44cfec200c874382dc7a8b34016a74228f","before":"  _keydown(event) {\n    if (!([ARROW_LEFT_KEY, ARROW_RIGHT_KEY, ARROW_UP_KEY, ARROW_DOWN_KEY].includes(event.key))) {\n      return\n    }\n\n    event.stopPropagation()// stopPropagation/preventDefault both added to support up/down keys without scrolling the page\n    event.preventDefault()\n    const isNext = [ARROW_RIGHT_KEY, ARROW_DOWN_KEY].includes(event.key)\n    const nextActiveElement = getNextActiveElement(this._getChildren(), event.target, isNext, true)\n    Tab.getOrCreateInstance(nextActiveElement).show()\n  }","after":"  _keydown(event) {\n    if (!([ARROW_LEFT_KEY, ARROW_RIGHT_KEY, ARROW_UP_KEY, ARROW_DOWN_KEY].includes(event.key))) {\n      return\n    }\n\n    event.stopPropagation()// stopPropagation/preventDefault both added to support up/down keys without scrolling the page\n    event.preventDefault()\n    const isNext = [ARROW_RIGHT_KEY, ARROW_DOWN_KEY].includes(event.key)\n    let nextActiveElement = getNextActiveElement(this._getChildren(), event.target, isNext, true)\n    // Skip disabled elements\n    let checked = 0\n    const children = this._getChildren()\n    while (isDisabled(nextActiveElement) && checked < children.length) {\n      nextActiveElement = getNextActiveElement(children, nextActiveElement, isNext, true)\n      checked++\n    }\n    Tab.getOrCreateInstance(nextActiveElement).show()\n  }"}],"expected_accessibility_effect":"ArrowRight will now move focus to the next enabled tab (Billing) skipping the disabled Notifications tab, updating aria-selected and focus accordingly, and ArrowLeft will wrap to the last enabled tab.","functional_risks":["Infinite loop mitigated by length check; if all tabs are disabled, the last checked disabled tab may be selected.","Behavior change if tabs are disabled after initialization; the navigation will skip them as intended.","Ensure that show() is not called on a disabled tab; the loop prevents this unless all tabs are disabled."],"verification_requirements":["Press ArrowRight from Account tab → Billing tab becomes aria-selected=true and receives focus.","Press ArrowLeft from Billing tab → Account tab becomes aria-selected=true and receives focus (wrapping if needed).","Repeated ArrowRight/Left navigation skips the disabled Notifications tab.","Screen reader announces the newly selected tab.","Tab panel visibility updates correctly when tab changes."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-a1ec75a90d574768f891b493999ecaea","promptHash":"bdc4e3300be2671b39ec5d350ecc7b5ba1330b401ead30be99656a1c5c0e7111","schemaVersion":2,"structuredOutput":false,"latencyMs":16327,"usage":{"completion_tokens":3506,"prompt_tokens":15072,"total