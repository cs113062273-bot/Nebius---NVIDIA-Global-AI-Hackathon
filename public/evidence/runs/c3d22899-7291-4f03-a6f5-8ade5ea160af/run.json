 = false;\n        });\n      }\n    }\n  }\n}","after":"export function initCheckboxes() {\n  const checkboxes = document.querySelectorAll('[data-module=\"nhsuk-checkboxes\"]');\n  checkboxes.forEach(container => {\n    const inputs = container.querySelectorAll('input[type=\"checkbox\"]');\n    inputs.forEach(input => {\n      input.addEventListener('click', handleClick);\n      input.addEventListener('change', handleChange);\n    });\n  });\n\n  function handleClick(event) {\n    const input = event.target;\n    if (input.hasAttribute('data-checkbox-exclusive')) {\n      const group = input.getAttribute('data-checkbox-exclusive-group');\n      if (group && input.checked) {\n        container.querySelectorAll(`input[type=\"checkbox\"][data-checkbox-exclusive-group=\"${group}\"]:not([data-checkbox-exclusive])`).forEach(cb => {\n          cb.checked = false;\n          cb.dispatchEvent(new Event('change', { bubbles: true }));\n        });\n      }\n    }\n  }\n\n  function handleChange(event) {\n    const input = event.target;\n    if (input.matches('input[type=\"checkbox\"][data-checkbox-exclusive]')) {\n      const group = input.getAttribute('data-checkbox-exclusive-group');\n      if (group && input.checked) {\n        document.querySelectorAll(`input[type=\"checkbox\"][data-checkbox-exclusive-group=\"${group}\"]:not([data-checkbox-exclusive])`).forEach(cb => {\n          cb.checked = false;\n          cb.dispatchEvent(new Event('change', { bubbles: true }));\n        });\n      }\n    }\n  }\n}"}],"expected_accessibility_effect":"Keyboard users can now select 'No, I do not have any of these symptoms' and have previously ticked symptom checkboxes automatically cleared, matching the expected behavior for exclusive checkbox groups and satisfying WCAG 2.1.1 (Keyboard) and 4.1.2 (Name, Role, Value).","functional_risks":["Duplicate change event handling if the component is later fixed, potentially causing double unchecking.","The fix relies on the exclusive group attri