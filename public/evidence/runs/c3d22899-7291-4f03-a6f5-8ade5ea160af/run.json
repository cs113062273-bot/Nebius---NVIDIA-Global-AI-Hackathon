heckbox-exclusive-group=\"${group}\"]:not([data-checkbox-exclusive])`).forEach(cb => {\n        cb.checked = false;\n        cb.dispatchEvent(new Event('change', { bubbles: true }));\n      });\n    }\n  }\n});\n</script>\n</body>\n</html>"}],"expected_accessibility_effect":"Keyboard users can now select 'No, I do not have any of these symptoms' and have previously ticked symptom checkboxes automatically cleared, matching the expected behavior for exclusive checkbox groups and satisfying WCAG 2.1.1 (Keyboard) and 4.1.2 (Name, Role, Value).","functional_risks":["Duplicate change event handling if the component is later fixed, potentially causing double unchecking.","The fix relies on the exclusive group attribute being present on all related checkboxes; if markup changes, the fix may not apply."],"verification_requirements":["Run the frozen journey: tab to cough, press Space, tab to fever, press Space, tab to none, press Space; verify form data symptoms[cough] and symptoms[fever] are empty.","Test mouse click on 'none' checkbox still clears other checkboxes.","Ensure contact checkboxes (different group) are unaffected."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/Nemotron-3-Ultra-550b-a55b","requestId":"chatcmpl-1412348d9d656d76307ecc09a89ce7a6","promptHash":"1b857642f027fbd5e8f1f1ae44498f180ab1e548653521128b6dff23ea05712c","schemaVersion":2,"structuredOutput":false,"latencyMs":28285,"usage":{"completion_tokens":11712,"prompt_tokens":4487,"total_tokens":16199,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":10983,"rejected_prediction_tokens":null},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":0,"multimodal_tokens":null},"prompt_cache_hit_tokens":0,"prompt_cache_miss_tokens":4487},"pricing":{"prompt":"0.000001","input_cache_read":"0.00000012","completion":"0.000003","image":"0","price_per_video_second":"0","request":"0","price_per_minute":"0"},"reservedCreditUsd":0.11304800000000