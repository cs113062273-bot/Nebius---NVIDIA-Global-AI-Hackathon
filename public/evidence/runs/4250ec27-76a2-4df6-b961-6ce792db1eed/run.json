ribute('data-checkbox-exclusive-group');\n          if (group) {\n            container.querySelectorAll(`input[type=\"checkbox\"][data-checkbox-exclusive-group=\"${group}\"]`).forEach((other) => {\n              if (other !== checkbox && other.checked) {\n                other.checked = false;\n                other.dispatchEvent(new Event('change', { bubbles: true }));\n              }\n            });\n          } else {\n            container.querySelectorAll('input[type=\"checkbox\"]').forEach((other) => {\n              if (other !== checkbox && other.checked) {\n                other.checked = false;\n                other.dispatchEvent(new Event('change', { bubbles: true }));\n              }\n            });\n          }\n        }\n      });\n    });\n  });\n}"}],"expected_accessibility_effect":"Keyboard users can now reliably select 'No, I do not have any of these symptoms' after ticking other symptoms, and the exclusive option will correctly clear previous selections, matching the expected form behavior and preventing contradictory submissions.","functional_risks":["If the component is used without a group attribute, the fallback unchecks all checkboxes in the container, which may affect unrelated groups.","Dispatching synthetic change events may trigger duplicate handlers if not idempotent."],"verification_requirements":["Run the frozen journey: tab to cough, space, tab to fever, space, tab to none, space — verify symptoms[cough] and symptoms[fever] are cleared.","Test mouse/touch interaction on the exclusive checkbox.","Verify contact checkboxes (different group) still work independently.","Check that unchecking the exclusive checkbox does not re-enable others automatically."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/Nemotron-3-Ultra-550b-a55b","requestId":"chatcmpl-c07b6c68c879b006b6b99e4ea00a86b6","promptHash":"7446deb5f6e48c65d6908b9d3fc467da3471fb073bc1ccdac5aabce02ef30bef","schemaVersion":2,"structuredOutput":false,"latency