ader.prototype.syncState to conditionally apply aria-hidden only when the menu button is visible (mobile); otherwise ensure the navigation is visible by removing aria-hidden.","edits":[{"path":"src/govuk/components/header/header.js","sha256":"33e331b7a1f44087522e90d1e295dbc0f915c8b8a82e8afd57a794d21fff4424","before":"Header.prototype.syncState = function (isVisible) {\n  this.$menuButton.classList.toggle('govuk-header__menu-button--open', isVisible)\n  this.$menuButton.setAttribute('aria-expanded', isVisible)\n  this.$menu.setAttribute('aria-hidden', !isVisible)\n}","after":"Header.prototype.syncState = function (isVisible) {\n  this.$menuButton.classList.toggle('govuk-header__menu-button--open', isVisible)\n  this.$menuButton.setAttribute('aria-expanded', isVisible)\n  // Only hide menu when menu button is visible (mobile)\n  if (this.$menuButton && this.$menuButton.offsetParent !== null) {\n    this.$menu.setAttribute('aria-hidden', !isVisible);\n  } else {\n    // Menu button hidden (desktop): ensure menu is visible\n    this.$menu.removeAttribute('aria-hidden');\n  }\n}"}],"expected_accessibility_effect":"Navigation links will be present in the accessibility tree as links, allowing screen reader users to navigate to them via Tab and hear their correct name and role.","functional_risks":["If the window is resized after initialization, the menu button visibility may change and the aria-hidden state may not update until the next menu button click or page reload.","The conditional check relies on offsetParent; if the button is hidden via other means (e.g., visibility:hidden) offsetParent may still be non-null, potentially leaving aria-hidden incorrectly set."],"verification_requirements":["Verify that the AX assertion for #nav-apply (name: \"Apply\", role: \"link\") passes after the change.","Verify that the menu button still functions correctly on narrow viewports: clicking toggles aria-expanded and applies/removes aria-hidden on the navigation.","Ensure that when 