le":"Arrow past a disabled settings tab","goal":"ArrowRight skips the disabled tab and selects the next enabled one","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the Account tab","action":{"kind":"seek","selector":"#tab-account","maxTabs":24},"assertions":[]},{"title":"Move right past the disabled Notifications tab","action":{"kind":"press","key":"ArrowRight"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"focus","selector":"#tab-billing"}]}],"success":[{"kind":"focus","selector":"#tab-billing"},{"kind":"visible","selector":"#billing-plan","value":true}],"functional":[{"kind":"attribute","selector":"#tab-notifications","name":"aria-selected","value":"false"},{"kind":"visible","selector":"#notify-email","value":false}],"forbidden":[]},"functionalJourney":{"version":1,"id":"bootstrap-tabs-disabled-pointer","title":"Switch settings sections with the mouse","goal":"Clicking a tab shows its panel","source":"authored","profile":"pointer","path":"/","steps":[{"title":"Open Billing","action":{"kind":"click","selector":"#tab-billing"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":true}]},{"title":"Return to Account","action":{"kind":"click","selector":"#tab-account"},"assertions":[{"kind":"attribute","selector":"#tab-account","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#account-name","value":true}]}],"success":[{"kind":"visible","selector":"#account-name","value":true}],"functional":[{"kind":"attribute","selector":"#tab-account","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":false}],"forbidden":[]},"guards":[{"version":1,"id":"bootstrap-tabs-disabled-left-guard","title":"Arrow left wraps to the last tab","goal":"ArrowLeft from the first tab selects Billing","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the Account tab","action":{"kind":"seek","selector":"#tab-account","maxTabs":24},"assertions":[]},{"title":"Wrap left to Billing","action":{"kind":"press","key":"ArrowLeft"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"focus","selector":"#tab-billing"}]}],"success":[{"kind":"focus","selector":"#tab-billing"}],"functional":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":true}],"forbidden":[]}],"guardsHash":"ebea33ab19683c1fe77d44af60b14e7b204f03737fe60c6814a719cad0ec1288","attempts":[{"attempt":1,"startedAt":"2026-10-26T14:06:07.158Z","verified":true,"category":null,"plan":{"root_cause":"The _keydown method in tab.js uses getNextActiveElement which does not skip disabled tabs, causing arrow navigation to move focus to disabled tabs instead of the next enabled tab.","repair_strategy":"Replace _keydown logic to iterate over tab children in the arrow direction, skipping disabled elements using the isDisabled utility, while preserving wrapping behavior.","edits":[{"path":"js/src/tab.js","sha256":"7ad4e9f0424d0d4b95bcf399a1639e44cfec200c874382dc7a8b34016a74228f","before":"  _keydown(event) {\n    if (!([ARROW_LEFT_KEY, ARROW_RIGHT_KEY, ARROW_UP_KEY, ARROW_DOWN_KEY].includes(event.key))) {\n      return\n    }\n\n    event.stopPropagation()// stopPropagation/preventDefault both added to support up/down keys without scrolling the page\n    event.preventDefault()\n    const isNext = [ARROW_RIGHT_KEY, ARROW_DOWN_KEY].includes(event.key)\n    const nextActiveElement = getNextActiveElement(this._getChildren(), event.target, isNext, true)\n    Tab.getOrCreateInstance(nextActiveElement).show()\n  }","after":"  _keydown(event) {\n    if (!([ARROW_LEFT_KEY, ARROW_RIGHT_KEY, ARROW_UP_KEY, ARROW_DOWN_KEY].includes(event.key))) {\n      return\n    }\n\n    event.stopPropagation()// stopPropagation/preventDefault both added to support up/down keys without scrolling the page\n    event.preventDefault()\n    const isNext = [ARROW_RIGHT_KEY, ARROW_DOWN_KEY].includes(event.key)\n    const children = this._getChildren()\n    let activeIndex = children.indexOf(event.target)\n    if (activeIndex === -1) {\n      activeIndex = 0\n    }\n    let len = children.length\n    let i = activeIndex\n    do {\n      i = isNext ? (i + 1) % len : (i - 1 + len) % len\n      if (!isDisabled(children[i])) {\n        break\n      }\n    } while (i !== activeIndex)\n    const nextActiveElement = children[i]\n    Tab.getOrCreateInstance(nextActiveElement).show()\n  }"}],"expected_accessibility_effect":"ArrowRight will move focus from the Account tab to the Billing tab, skipping the disabled Notifications tab, updating aria-selected and visibility accordingly.","functional_risks":["If all tabs are disabled, the script may attempt to show a disabled tab (unlikely in practice).","Relies on isDisabled detecting disabled state via class or attribute; custom disabled styling not captured could be missed.","Wrapping behavior preserved but now skips disabled tabs during wrap."],"verification_requirements":["After ArrowRight from Account tab, focus is on Billing tab, aria-selected=\"true\" on Billing, tabpanel visible.","After ArrowLeft from Billing tab, focus returns to Account tab.","ArrowRight from Billing tab wraps to Account tab (skipping disabled).","ArrowLeft from Account tab wraps to Billing tab (skipping disabled).","Disabled Notification tab never receives focus or aria-selected=\"true\" during navigation."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-e220c6f2c9c8e664c6fb10a9d9706c60","promptHash":"bdc4e3300be2671b39ec5d350ecc7b5ba1330b401ead30be99656a1c5c0e7111","schemaVersion":2,"structuredOutput":false,"latencyMs":30587,"usage":{"completion_tokens":4536,"prompt_tokens":15072,"total_tokens":19608,"completion_tokens_details"