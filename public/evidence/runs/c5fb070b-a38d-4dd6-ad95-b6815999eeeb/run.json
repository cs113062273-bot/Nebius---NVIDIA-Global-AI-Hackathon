ile":"keyboard","path":"/","steps":[{"title":"Reach the summary field","action":{"kind":"seek","selector":"#summary","maxTabs":24},"assertions":[]},{"title":"Type thirty characters","action":{"kind":"type","text":"Map does not load on my phone."},"assertions":[]}],"success":[{"kind":"text","selector":"#summary-group .govuk-character-count__status","value":"You have 0 characters remaining"}],"functional":[{"kind":"form-data","selector":"#report-form","name":"summary","value":["Map does not load on my phone."]}],"forbidden":[]}],"guardsHash":"23d1d1846af860885d8a04d385437eeca509aa47ed4f8e3b55278984415d0578","attempts":[{"attempt":1,"startedAt":"2026-10-26T06:30:27.616Z","verified":true,"category":null,"plan":{"root_cause":"The textarea retains the maxlength attribute, causing the browser to truncate input beyond the limit. This prevents the character-count script from seeing the full value and showing the appropriate overflow message.","repair_strategy":"Remove the maxlength attribute from the textarea element in the CharacterCount.init method, allowing the script to manage the limit and provide accurate feedback while preserving the hard‑lift fallback for non‑JavaScript users via the noscript‑safe attribute on the module.","edits":[{"path":"src/govuk/components/character-count/character-count.js","sha256":"b17688138faafe0e8e1b3b435f890c52c8dc6ca9fbcbb8644f2e93a5125f7b90","before":"  // Save the element limit\n  this.maxLength = $module.getAttribute(countAttribute)\n\n  // Check for limit\n  if (!this.maxLength) {\n    return\n  }\n\n  // Remove hard limit if set\n  $module.removeAttribute('maxlength')","after":"  // Save the element limit\n  this.maxLength = $module.getAttribute(countAttribute)\n\n  // Check for limit\n  if (!this.maxLength) {\n    return\n  }\n\n  // Remove hard limit if set\n  $textarea.removeAttribute('maxlength')\n  $module.removeAttribute('maxlength')"}],"expected_accessibility_effect":"Users will receive accurate real‑time feedback about remaining or excess characters, satisfying WCAG 2.1.1 (Keyboard) and 4.1.2 (Name, Role, Value) as the textarea’s value and associated messages reflect the true input length.","functional_risks":["Removing maxlength via JS may allow temporary entry of unlimited characters before the script updates, potentially bypassing server‑side validation if relied upon.","If other scripts depend on the textarea’s maxlength attribute for fallback behavior, they may need adjustment.","The noscript fallback still enforces the limit via the textarea’s maxlength attribute, so users without JavaScript remain protected."],"verification_requirements":["Type more than 30 characters and verify the character count shows \"You have X characters too many\".","Confirm the textarea’s value is not truncated and equals the full input.","Ensure that with JavaScript disabled, the textarea still enforces the 30‑character limit via the maxlength attribute.","Check that focus, blur, and keyboard interaction continue to work as expected."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-56bbd9a9498b53184f469bb0cd1bcef7","promptHash":"9df1258bc5b313ddc063b85c2ef65b301ebd48a51c8b92ad3a5695e64201f606","schemaVersion":2,"structuredOutput":false,"latencyMs":21116,"usage":{"completion_tokens":3253,"prompt_tokens":6044,"total_tokens":9297,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":2663,"rejected_prediction_tokens":null},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":0,"created_cache_tokens":0,"multimodal_tokens":null},"prompt_cache_hit_tokens":0,"prompt_cache_miss_tokens":6044},"pricing":{"prompt":"0.0000003","input_cache_read":"0.00000006","completion":"0.0000009","image":"0","price_per_video_second":"0","request":"0","price_per_minute":"0"},"reservedCreditUsd":0.0358806,"budgetScope":"realbugs-20261025","cacheHit":false,"retries":0,"attemptedCompletions":1,"responseFile":"re