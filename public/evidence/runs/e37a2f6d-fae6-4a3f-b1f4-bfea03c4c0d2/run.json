ile":"keyboard","path":"/","steps":[{"title":"Reach the summary field","action":{"kind":"seek","selector":"#summary","maxTabs":24},"assertions":[]},{"title":"Type thirty characters","action":{"kind":"type","text":"Map does not load on my phone."},"assertions":[]}],"success":[{"kind":"text","selector":"#summary-group .govuk-character-count__status","value":"You have 0 characters remaining"}],"functional":[{"kind":"form-data","selector":"#report-form","name":"summary","value":["Map does not load on my phone."]}],"forbidden":[]}],"guardsHash":"23d1d1846af860885d8a04d385437eeca509aa47ed4f8e3b55278984415d0578","attempts":[{"attempt":1,"startedAt":"2026-10-26T05:11:05.266Z","verified":true,"category":null,"plan":{"root_cause":"The character count plugin incorrectly attempts to remove the maxlength attribute from the container div ($module) instead of the textarea ($textarea). This leaves the browser‑enforced maxlength active, causing input to be truncated at the limit rather than allowing the script to manage overflow via UI messages.","repair_strategy":"Change the removal target from $module to $textarea so the hard maxlength attribute is removed from the textarea, enabling the plugin to count characters and update visible/screen‑reader messages while permitting input beyond the limit.","edits":[{"path":"src/govuk/components/character-count/character-count.js","sha256":"b17688138faafe0e8e1b3b435f890c52c8dc6ca9fbcbb8644f2e93a5125f7b90","before":"  // Remove hard limit if set\n  $module.removeAttribute('maxlength')\n","after":"  // Remove hard limit if set\n  $textarea.removeAttribute('maxlength')\n"}],"expected_accessibility_effect":"Users can type beyond the 30‑character limit and receive accurate feedback via the visible character count and screen‑reader live region, satisfying WCAG 2.1.1 (Keyboard) and 4.1.2 (Name, Role, Value) by ensuring the textarea’s full value is preserved and conveyed.","functional_risks":["Removing the maxlength attribute could allow excessively long inputs that may exceed server‑side limits or cause performance issues if no other validation exists.","If the plugin fails to update the error state correctly, users might not receive visual indication of over‑limit input."],"verification_requirements":["Confirm that typing more than 30 characters retains the full string in the textarea’s value.","Verify that the visible counter shows a negative remaining count (e.g., \"You have 4 characters too many\") and receives the govuk-textarea--error styling when over the limit.","Ensure screen‑reader announcements reflect the same message via the live region.","Check that keyboard focus and tab order remain unaffected."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-9da78409916cdcc4b48bd18bece5fb62","promptHash":"9df1258bc5b313ddc063b85c2ef65b301ebd48a51c8b92ad3a5695e64201f606","schemaVersion":2,"structuredOutput":false,"latencyMs":14869,"usage":{"completion_tokens":2638,"prompt_tokens":6044,"total_tokens":8682,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":2136,"rejected_prediction_tokens":null},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":0,"created_cache_tokens":0,"multimodal_tokens":null},"prompt_cache_hit_tokens":0,"prompt_cache_miss_tokens":6044},"pricing":{"prompt":"0.0000003","input_cache_read":"0.00000006","completion":"0.0000009","image":"0","price_per_video_second":"0","request":"0","price_per_minute":"0"},"reservedCreditUsd":0.0358806,"budgetScope":"realbugs-20261025","cacheHit":false,"retries":0,"attemptedCompletions":1,"responseFile":"response-2c74ccda1685256eb03d99088b44e47caef8f59eba29624efae9cba77147f2db-434.json","requestFile":"request-2c74ccda1685256eb03d99088b44e47caef8f59eba29624efae9cba77147f2db-434.json"},"patchValidation":{"gitApplyCheck":true,"candidateBytesMatch":true,"contextLines":3},"changes":[{"path":"src/govuk/components/character-count/character-cou