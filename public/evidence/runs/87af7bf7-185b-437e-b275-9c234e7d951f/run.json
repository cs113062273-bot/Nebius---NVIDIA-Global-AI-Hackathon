le":"Arrow past a disabled settings tab","goal":"ArrowRight skips the disabled tab and selects the next enabled one","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the Account tab","action":{"kind":"seek","selector":"#tab-account","maxTabs":24},"assertions":[]},{"title":"Move right past the disabled Notifications tab","action":{"kind":"press","key":"ArrowRight"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"focus","selector":"#tab-billing"}]}],"success":[{"kind":"focus","selector":"#tab-billing"},{"kind":"visible","selector":"#billing-plan","value":true}],"functional":[{"kind":"attribute","selector":"#tab-notifications","name":"aria-selected","value":"false"},{"kind":"visible","selector":"#notify-email","value":false}],"forbidden":[]},"functionalJourney":{"version":1,"id":"bootstrap-tabs-disabled-pointer","title":"Switch settings sections with the mouse","goal":"Clicking a tab shows its panel","source":"authored","profile":"pointer","path":"/","steps":[{"title":"Open Billing","action":{"kind":"click","selector":"#tab-billing"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":true}]},{"title":"Return to Account","action":{"kind":"click","selector":"#tab-account"},"assertions":[{"kind":"attribute","selector":"#tab-account","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#account-name","value":true}]}],"success":[{"kind":"visible","selector":"#account-name","value":true}],"functional":[{"kind":"attribute","selector":"#tab-account","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":false}],"forbidden":[]},"guards":[{"version":1,"id":"bootstrap-tabs-disabled-left-guard","title":"Arrow left wraps to the last tab","goal":"ArrowLeft from the first tab selects Billing","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the Account tab","action":{"kind":"seek","selector":"#tab-account","maxTabs":24},"assertions":[]},{"title":"Wrap left to Billing","action":{"kind":"press","key":"ArrowLeft"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"focus","selector":"#tab-billing"}]}],"success":[{"kind":"focus","selector":"#tab-billing"}],"functional":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":true}],"forbidden":[]}],"guardsHash":"ebea33ab19683c1fe77d44af60b14e7b204f03737fe60c6814a719cad0ec1288","attempts":[{"attempt":1,"startedAt":"2026-10-26T02:42:17.260Z","verified":true,"category":null,"plan":{"root_cause":"The _keydown method in tab.js uses getNextActiveElement which does not skip disabled tabs, causing arrow navigation to move focus to a disabled tab instead of the next enabled tab.","repair_strategy":"Modify the _keydown method to filter out disabled tabs before determining the next target, using the isDisabled utility already imported.","edits":[{"path":"js/src/tab.js","sha256":"7ad4e9f0424d0d4b95bcf399a1639e44cfec200c874382dc7a8b34016a74228f","before":"  _keydown(event) {\n    if (!([ARROW_LEFT_KEY, ARROW_RIGHT_KEY, ARROW_UP_KEY, ARROW_DOWN_KEY].includes(event.key))) {\n      return\n    }\n\n    event.stopPropagation()// stopPropagation/preventDefault both added to support up/down keys without scrolling the page\n    event.preventDefault()\n    const isNext = [ARROW_RIGHT_KEY, ARROW_DOWN_KEY].includes(event.key)\n    const nextActiveElement = getNextActiveElement(this._getChildren(), event.target, isNext, true)\n    Tab.getOrCreateInstance(nextActiveElement).show()\n  }","after":"  _keydown(event) {\n    if (!([ARROW_LEFT_KEY, ARROW_RIGHT_KEY, ARROW_UP_KEY, ARROW_DOWN_KEY].includes(event.key))) {\n      return\n    }\n\n    event.stopPropagation()// stopPropagation/preventDefault both added to support up/down keys without scrolling the page\n    event.preventDefault()\n    const isNext = [ARROW_RIGHT_KEY, ARROW_DOWN_KEY].includes(event.key)\n    const children = this._getChildren()\n    const enabledChildren = children.filter(child => !isDisabled(child))\n    if (enabledChildren.length === 0) {\n      return\n    }\n    let targetIndex = enabledChildren.indexOf(event.target)\n    if (targetIndex === -1) {\n      targetIndex = 0\n    }\n    let nextIndex = isNext ? targetIndex + 1 : targetIndex - 1\n    if (isNext && nextIndex >= enabledChildren.length) {\n      nextIndex = 0\n    }\n    if (!isNext && nextIndex < 0) {\n      nextIndex = enabledChildren.length - 1\n    }\n    const nextActiveElement = enabledChildren[nextIndex]\n    Tab.getOrCreateInstance(nextActiveElement).show()\n  }"}],"expected_accessibility_effect":"ArrowRight will skip the disabled Notifications tab and move focus to the Billing tab, updating aria-selected to true on #tab-billing and making the billing panel visible.","functional_risks":["If all tabs are disabled (unlikely), the method will early-return and no tab will be activated.","The change only affects horizontal arrow navigation in tablists; vertical arrow navigation (if used elsewhere) remains unchanged.","Disabled tabs remain unfocusable and unselected, which is correct behavior."],"verification_requirements":["Starting with Account tab selected, pressing ArrowRight results in Billing tab receiving focus, aria-selected=\"true\", and its panel visible.","Pressing ArrowRight from Billing tab wraps to Account tab (skipping disabled Notifications).","Pressing ArrowLeft from Account tab wraps to Billing tab (skipping disabled Notifications).","The Notifications tab remains disabled, unfocusable, and with aria-selected=\"false\"."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-5ec61daa2e02faaef09785dec434b576","promptHash":"c5641fdd5165e15a4816628fcff49346e58e1b931550350e840