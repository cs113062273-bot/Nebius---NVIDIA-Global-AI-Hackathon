focus restoration.","edits":[{"path":"src/a11y-dialog.js","sha256":"9dbd1daa87fcac8518db48e4cbb4b0eeea7c30c92a6171ff59cbc895938aaf4c","before":"/**\\n   * Hide the dialog element, restore the focus to the previously active\\n   * element, stop listening for some specific key presses and fire all\\n   * registered callbacks for `hide` event\\n   */\\n         hide(event        ) {\\n    // If the dialog is already closed, abort\\n    if (!this.shown) return this\\n\\n    // Dispatch a `hide` event\\n    const hideEvent = this.fire('hide', event)\\n\\n    // If the event was prevented, do not continue with the normal behavior\\n    if (hideEvent.defaultPrevented) return this\\n\\n    this.shown = false\\n    this.$el.setAttribute('aria-hidden', 'true')\\n\\n    // Ensure the previously focused element (if any) has a `focus` method\\n    // before attempting to call it to account for SVG elements\\n    // See: https://github.com/KittyGiraudel/a11y-dialog/issues/108\\n    this.previouslyFocused?.focus?.()\\n\\n    // Remove the focus event listener to the body element and stop listening\\n    // for specific key presses\\n    document.body.removeEventListener('focus', this.maintainFocus, true)\\n    this.$el.removeEventListener('keydown', this.bindKeypress, true)\\n\\n    return this\\n  }\\n","after":"/**\\n   * Hide the dialog element, restore the focus to the previously active\\n   * element, stop listening for some specific key presses and fire all\\n   * registered callbacks for `hide` event\\n   */\\n         hide(event        ) {\\n    // If the dialog is already closed, abort\\n    if (!this.shown) return this\\n\\n    // Dispatch a `hide` event\\n    const hideEvent = this.fire('hide', event)\\n\\n    // If the event was prevented, do not continue with the normal behavior\\n    if (hideEvent.defaultPrevented) return this\\n\\n    this.shown = false\\n    this.$el.setAttribute('aria-hidden', 'true')\\n\\n    // Remove the focus event listener to the body element and stop listening\\n    // for specific key presses\\n    document.body.removeEventListener('focus', this.maintainFocus, true)\\n    this.$el.removeEventListener('keydown', this.bindKeypress, true)\\n\\n    // Ensure the previously focused element (if any) has a `focus` method\\n    // before attempting to call it to account for SVG elements\\n    // See: https://github.com/KittyGiraudel/a11y-dialog/issues/108\\n    this.previouslyFocused?.focus?.()\\n\\n    return this\\n  }\\n"}],"expected_accessibility_effect":"Focus returns to the opener button after closing the dialog with Escape, preserving logical focus order and meeting WCAG 2.1.1 keyboard accessibility.","functional_risks":["Removing listeners too early could theoretically allow focus to escape while the dialog is still visible, but listeners are removed after setting aria-hidden true (visually hiding the dialog) and before focus restoration, minimizing risk."],"verification_requirements":["Verify that pressing Escape after opening the dialog moves focus to the opener button.","Verify that the dialog's aria-hidden attribute is true after closing.","Verify that Tab key still traps focus within the dialog while it is open.","Verify no JavaScript errors are thrown during open/close cycles."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-5db5504f092151d7ffc9f6338bf1aca6","promptHash":"48abadeda945cf5c94aa9040bed8055c10095b156cbf3ea7c9c78a1fefb210c2","schemaVersion":2,"structuredOutput":false,"latencyMs":27183,"usage":{"completion_tokens":4405,"prompt_tokens":13481,"total_tokens":17886,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":3430,"rejected_prediction_tokens":null},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":0,"created_cache_tokens":0,"multimodal_tokens":null},"prompt_cache_hit_tokens":0,"prompt_cache_miss_tokens":13481},"pricing":{"prompt":"0.0000003","input_cache_