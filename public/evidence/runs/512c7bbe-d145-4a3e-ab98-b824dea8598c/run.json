form-data","selector":"#appointment","name":"day","value":["2026-11-26"]}]}],"success":[{"kind":"form-data","selector":"#appointment","name":"day","value":["2026-11-26"]}],"functional":[{"kind":"focus","selector":"#day"}],"forbidden":[]}],"guardsHash":"d98b512309140e3568dd4a5c2d029f01d5d3e991347e9625421fec83ef0d9a36","attempts":[{"attempt":1,"startedAt":"2026-10-26T15:36:43.332Z","verified":true,"category":null,"plan":{"root_cause":"The ArrowRight key handler in _onKeyChange calls adjustDate('add',1) which moves the calendar forward by exactly one day without checking whether that day is disabled (e.g., a weekend). Consequently, from Friday 20 November 2026 ArrowRight lands on Saturday 21 November instead of skipping to the next selectable day Monday 23 November.","repair_strategy":"Replace the ArrowRight (and ArrowLeft) cases in _onKeyChange with logic that increments/decrements the date by one day repeatedly until a non‑disabled date is found, using the same disability logic that the renderer employs (min/max dates, disableWeekends, disableDayFn). Leave ArrowUp/Down and other keys unchanged.","edits":[{"path":"pikaday.js","sha256":"a50b66482ec18884a7200882e9b523d9192b224b40b296cdd4080530f114fa75","before":"        self._onKeyChange = function(e)\n        {\n            e = e || window.event;\n\n            if (self.isVisible()) {\n\n                switch(e.keyCode){\n                    case 13:\n                    case 27:\n                        if (opts.field) {\n                            opts.field.blur();\n                        }\n                        break;\n                    case 37:\n                        self.adjustDate('subtract', 1);\n                        break;\n                    case 38:\n                        self.adjustDate('subtract', 7);\n                        break;\n                    case 39:\n                        self.adjustDate('add', 1);\n                        break;\n                    case 40:\n                        self.adjustDate('add', 7);\n                        break;\n                    case 8:\n                    case 46:\n                        self.setDate(null);\n                        break;\n                }\n            }\n        };","after":"        self._onKeyChange = function(e)\n        {\n            e = e || window.event;\n\n            if (self.isVisible()) {\n                function isDateDisabled(d) {\n                    if (opts.minDate && d < opts.minDate) return true;\n                    if (opts.maxDate && d > opts.maxDate) return true;\n                    if (opts.disableWeekends && isWeekend(d)) return true;\n                    if (opts.disableDayFn && opts.disableDayFn(d)) return true;\n                    return false;\n                }\n\n                switch(e.keyCode){\n                    case 13:\n                    case 27:\n                        if (opts.field) {\n                            opts.field.blur();\n                        }\n                        break;\n                    case 37:\n                        var current = self.getDate() || new Date();\n                        var prev = new Date(current.getTime());\n                        do {\n                            prev.setDate(prev.getDate() - 1);\n                        } while (isDateDisabled(prev));\n                        self.setDate(prev);\n                        break;\n                    case 38:\n                        self.adjustDate('subtract', 7);\n                        break;\n                    case 39:\n                        var current = self.getDate() || new Date();\n                        var next = new Date(current.getTime());\n                        do {\n                            next.setDate(next.getDate() + 1);\n                        } while (isDateDisabled(next));\n                        self.setDate(next);\n                        break;\n                    case 40:\n                        self.adjustDate('add', 7);\n                        break;\n                    case 8:\n                    case 46:\n                        self.setDate(null);\n                        break;\n                }\n            }\n        };"}],"expected_accessibility_effect":"Keyboard users can now navigate to the next or previous selectable day using ArrowRight and ArrowLeft, skipping disabled days such as weekends. This restores logical focus order and improves usability for users who rely on keyboard navigation, satisfying WCAG 2.1.1 (Keyboard) and 2.4.3 (Focus Order).","functional_risks":["If the minDate, maxDate, and disableDayFn collectively disable all dates in the calendar, the loop could become infinite (though this configuration is unrealistic).","Performance impact is negligible for typical weekend skipping; however, navigating across many consecutive disabled days (e.g., a long blocked range) could take extra iterations.","ArrowUp/Down (week jumps) remain unchanged and may land on disabled days; this is acceptable as the requirement only concerns day‑by‑day navigation.","Changing the core navigation logic could affect edge cases near month or year boundaries where the disabled check interacts with min/max dates; these are mitigated by reusing the same disability logic used elsewhere."],"verification_requirements":["Verify that with the default configuration (weekends disabled, defaultDate 2026-11-20) pressing ArrowRight from Friday 2026-11-20 results in the input value 2026-11-23.","Verify that pressing ArrowLeft from Monday 2026-11-23 results in the input value 2026-11-20.","Ensure ArrowRight/Left respect minDate and maxDate boundaries and do not exceed them.","Confirm that ArrowUp/Down still shift the view by seven days as before.","Check that focus remains on the #day input after each key press and that no JavaScript errors are thrown.","Run the existing test suite to ensure no regressions in other interactions (mouse selection, month/year dropdowns, etc.)."]}