{"id":"512c7bbe-d145-4a3e-ab98-b824dea8598c","fixture":"custom-project","mode":"nebius","source":{"kind":"source","name":"Arrow keys must not select a day that disableDayFn closes","originalRoot":".\\benchmarks\\openbugs\\pikaday-keyboard-disabled-day\\original","scope":"Open upstream bug (https://github.com/Pikaday/Pikaday/issues/955) at 9a90eea5cdbc48784d3a909ddb36e052c16bf25d, unfixed when pinned. Routing Super, then Ultra."},"state":"VERIFIED","events":[{"state":"CREATED","at":"2026-10-26T15:36:39.840Z"},{"state":"PREPARING","detail":"Clean browser contexts; user-selected static source snapshot","at":"2026-10-26T15:36:39.843Z"},{"state":"BASELINE_RUNNING","detail":"Reproduce task and independent pointer functional baseline","at":"2026-10-26T15:36:39.935Z"},{"state":"FAILURE_CONFIRMED","detail":"Expected state did not occur after action","at":"2026-10-26T15:36:43.323Z"},{"state":"LOCALIZING","detail":"Rank source candidates from selector/name evidence","at":"2026-10-26T15:36:43.325Z"},{"state":"PLANNING_REPAIR","detail":"NVIDIA Nemotron proposes bounded edits via Nebius","at":"2026-10-26T15:36:43.332Z"},{"state":"PATCHING","detail":"Validate allowlist, hashes, unique preimages and change bounds in isolated copy","at":"2026-10-26T15:37:24.907Z"},{"state":"BUILDING","detail":"Validate static JavaScript syntax and HTML structure","at":"2026-10-26T15:37:25.110Z"},{"state":"REPLAYING","detail":"Same frozen journey, fresh browser context","at":"2026-10-26T15:37:25.117Z"},{"state":"VERIFYING","detail":"Deterministic task + functional + oracle + regression gate","at":"2026-10-26T15:37:27.180Z"},{"state":"VERIFIED","detail":"Verified only for the tested journey and conditions","at":"2026-10-26T15:37:27.237Z"}],"journeyHash":"4d2ddd868312f79731cf12470335c1b475c640c09340ff06d67fdfbc5a45713c","functionalJourneyHash":"44f3a82fc99b0c22ca145bf8573172511ac39c0fd325164954065d14135f5d94","journey":{"version":1,"id":"pikaday-arrow-skips-closed-day","title":"Move to the next open da