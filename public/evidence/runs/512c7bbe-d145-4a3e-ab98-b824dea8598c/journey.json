{
  "version": 1,
  "id": "pikaday-arrow-skips-closed-day",
  "title": "Move to the next open day with the arrow key",
  "goal": "From Friday 20 November, ArrowRight selects Monday 23 November, never a closed weekend day",
  "source": "authored",
  "profile": "keyboard",
  "path": "/",
  "steps": [
    {
      "title": "Reach the appointment field",
      "action": {
        "kind": "seek",
        "selector": "#day",
        "maxTabs": 24
      },
      "assertions": []
    },
    {
      "title": "Move one day forward",
      "action": {
        "kind": "press",
        "key": "ArrowRight"
      },
      "assertions": [
        {
          "kind": "form-data",
          "selector": "#appointment",
          "name": "day",
          "value": [
            "2026-11-23"
          ]
        }
      ]
    }
  ],
  "success": [
    {
      "kind": "form-data",
      "selector": "#appointment",
      "name": "day",
      "value": [
        "2026-11-23"
      ]
    }
  ],
  "functional": [
    {
      "kind": "focus",
      "selector": "#day"
    }
  ],
  "forbidden": []
}