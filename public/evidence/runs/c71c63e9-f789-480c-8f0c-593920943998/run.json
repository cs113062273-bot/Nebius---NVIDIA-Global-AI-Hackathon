                function isAllowedDate(date) {\n                    if (!isDate(date)) return false;\n                    if (self._o.minDate && date < self._o.minDate) return false;\n                    if (self._o.maxDate && date > self._o.maxDate) return false;\n                    if (self._o.disableWeekends && isWeekend(date)) return false;\n                    if (self._o.disableDayFn && self._o.disableDayFn(date)) return false;\n                    return true;\n                }\n                switch(e.keyCode){\n                    case 13:\n                    case 27:\n                        if (opts.field) {\n                            opts.field.blur();\n                        }\n                        break;\n                    case 37:\n                        var newDate = self.getDate() || new Date();\n                        do {\n                            newDate = new Date(newDate.valueOf() - 24*60*60*1000);\n                        } while (!isAllowedDate(newDate));\n                        self.setDate(newDate);\n                        break;\n                    case 38:\n                        var newDate = self.getDate() || new Date();\n                        do {\n                            newDate = new Date(newDate.valueOf() - 7*24*60*60*1000);\n                        } while (!isAllowedDate(newDate));\n                        self.setDate(newDate);\n                        break;\n                    case 39:\n                        var newDate = self.getDate() || new Date();\n                        do {\n                            newDate = new Date(newDate.valueOf() + 24*60*60*1000);\n                        } while (!isAllowedDate(newDate));\n                        self.setDate(newDate);\n                        break;\n                    case 40:\n                        var newDate = self.getDate() || new Date();\n                        do {\n                            newDate = new Date(newDate.valueOf() + 7*24*60*60*1000);\n                        } while (!isAllowedDate(newDate));\n                        self.setDate(newDate);\n                        break;\n                    case 8:\n                    case 46:\n                        self.setDate(null);\n                        break;\n                }\n            }"}],"expected_accessibility_effect":"Keyboard users can now navigate only to enabled weekdays using arrow keys, satisfying WCAG 2.1.1 (Keyboard) and 2.4.3 (Focus Order) by preventing focus on disabled dates.","functional_risks":["Potential infinite loop if all dates are disabled (unlikely given typical usage).","Week navigation may skip multiple weeks if many consecutive disabled days.","Boundary behavior at min/max dates must still work."],"verification_requirements":["Verify ArrowRight from a Friday moves to the following Monday.","Verify ArrowLeft from a Monday moves to the previous Friday.","Ensure navigation respects minDate and maxDate limits.","Confirm week arrows (Up/Down) skip weekends.","Ensure navigation does not get stuck when all days in a range are disabled."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-13cdd6240bed50deee3b552d984235a1","promptHash":"b9a5935e6d7e5a40168588ccc94201ba55dae7e6fc06bb38127ed83ce6729cb3","schemaVersion":2,"structuredOutput":false,"latencyMs":51053,"usage":{"completion_tokens":11504,"prompt_tokens":17212,"total_tokens":28716,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":10395,"rejected_prediction_tokens":null},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":0,"created_cache_tokens":8432,"multimodal_tokens":null},"prompt_cache_hit_tokens":0,"prompt_cache_miss_tokens":17212},"pricing":{"prompt":"0.0000003","input_cache_read":"0.00000006","completion":"0.0000009","image":"0","price_per_video_second":"0","request":"0","price_per_minute":"0"},"reservedCreditUsd":0.0479175,"bud