:{"version":1,"id":"historical-dialog-keyboard","title":"Restore focus after closing a real dialog","goal":"Focus returns to the opener","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach notice trigger","action":{"kind":"seek","selector":"#open","maxTabs":24},"assertions":[]},{"title":"Open notice","action":{"kind":"press","key":"Enter"},"assertions":[{"kind":"focus","selector":"#dialog"}]},{"title":"Dismiss notice and return to the opener","action":{"kind":"press","key":"Escape"},"assertions":[{"kind":"focus","selector":"#open"}]}],"success":[{"kind":"focus","selector":"#open"}],"functional":[{"kind":"attribute","selector":"#dialog","name":"aria-hidden","value":"true"}],"forbidden":[]},"functionalJourney":{"version":1,"id":"historical-dialog-pointer","title":"Restore focus after closing a real dialog","goal":"Focus returns to the opener","source":"authored","profile":"pointer","path":"/","steps":[{"title":"Open notice","action":{"kind":"click","selector":"#open"},"assertions":[{"kind":"attribute","selector":"#dialog","name":"aria-hidden","value":null}]},{"title":"Close notice with pointer","action":{"kind":"click","selector":"#close"},"assertions":[{"kind":"attribute","selector":"#dialog","name":"aria-hidden","value":"true"}]}],"success":[{"kind":"attribute","selector":"#dialog","name":"aria-hidden","value":"true"}],"functional":[{"kind":"attribute","selector":"#dialog","name":"aria-hidden","value":"true"}],"forbidden":[]},"attempts":[{"attempt":1,"startedAt":"2026-10-26T13:50:22.186Z","verified":true,"category":null,"plan":{"root_cause":"The focus listener (maintainFocus) is not removed before attempting to restore focus, causing it to intercept the focus event and return focus to the dialog.","repair_strategy":"Reorder the hide method to remove the focus and keydown listeners before restoring focus to the previously focused element.","edits":[{"path":"src/a11y-dialog.js","sha256":"9dbd1daa87fcac8518db48e4cbb4b0eeea7c30c92a6171ff59cbc895938aaf4c","before":"  /**\n   * Hide the dialog element, restore the focus to the previously active\n   * element, stop listening for some specific key presses and fire all\n   * registered callbacks for `hide` event\n   */\n         hide(event        ) {\n    // If the dialog is already closed, abort\n    if (!this.shown) return this\n\n    // Dispatch a `hide` event\n    const hideEvent = this.fire('hide', event)\n\n    // If the event was prevented, do not continue with the normal behavior\n    if (hideEvent.defaultPrevented) return this\n\n    this.shown = false\n    this.$el.setAttribute('aria-hidden', 'true')\n\n    // Ensure the previously focused element (if any) has a `focus` method\n    // before attempting to call it to account for SVG elements\n    // See: https://github.com/KittyGiraudel/a11y-dialog/issues/108\n    this.previouslyFocused?.focus?.()\n\n    // Remove the focus event listener to the body element and stop listening\n    // for specific key presses\n    document.body.removeEventListener('focus', this.maintainFocus, true)\n    this.$el.removeEventListener('keydown', this.bindKeypress, true)\n\n    return this\n  }\n","after":"  /**\n   * Hide the dialog element, restore the focus to the previously active\n   * element, stop listening for some specific key presses and fire all\n   * registered callbacks for `hide` event\n   */\n         hide(event        ) {\n    // If the dialog is already closed, abort\n    if (!this.shown) return this\n\n    // Dispatch a `hide` event\n    const hideEvent = this.fire('hide', event)\n\n    // If the event was prevented, do not continue with the normal behavior\n    if (hideEvent.defaultPrevented) return this\n\n    this.shown = false\n    this.$el.setAttribute('aria-hidden', 'true')\n\n    // Remove the focus event listener to the body element and stop listening\n    // for specific key presses\n    document.body.removeEventListener('focus', this.maintainFocus, true)\n    this.$el.removeEventListener('keydown', this.bindKeypress, true)\n\n    // Ensure the previously focused element (if any) has a `focus` method\n    // before attempting to call it to account for SVG elements\n    // See: https://github.com/KittyGiraudel/a11y-dialog/issues/108\n    this.previouslyFocused?.focus?.()\n\n    return this\n  }\n"},{"path":"src/a11y-dialog.ts","sha256":"4451a44bcda3dbdc5e31ce4e6e058e6bab71d86d4ee8dc410bcb3c4398fa14cc","before":"  /**\n   * Hide the dialog element, restore the focus to the previously active\n   * element, stop listening for some specific key presses and fire all\n   * registered callbacks for `hide` event\n   */\n  public hide(event?: Event) {\n    // If the dialog is already closed, abort\n    if (!this.shown) return this\n\n    // Dispatch a `hide` event\n    const hideEvent = this.fire('hide', event)\n\n    // If the event was prevented, do not continue with the normal behavior\n    if (hideEvent.defaultPrevented) return this\n\n    this.shown = false\n    this.$el.setAttribute('aria-hidden', 'true')\n\n    // Ensure the previously focused element (if any) has a `focus` method\n    // before attempting to call it to account for SVG elements\n    // See: https://github.com/KittyGiraudel/a11y-dialog/issues/108\n    this.previouslyFocused?.focus?.()\n\n    // Remove the focus event listener to the body element and stop listening\n    // for specific key presses\n    document.body.removeEventListener('focus', this.maintainFocus, true)\n    this.$el.removeEventListener('keydown', this.bindKeypress, true)\n\n    return this\n  }\n","after":"  /**\n   * Hide the dialog element, restore the focus to the previously active\n   * element, stop listening for some specific key presses and fire all\n   * registered callbacks for `hide` event\n   */\n  public hide(event?: Event) {\n    // If the dialog is already closed, abort\n    if (!this.shown) return this\n\n    // Dispatch a `hide` event\n    const hideEvent = this.fire('hide', event)\n\n    // If the event was prevented, do not continue with the normal behavior\n    if (hideEvent.defaultPrevented) return this\n\n    this.shown = false\n    this.$el.setAttribute('aria-hidden', 'true')\n\n    // Remove the focus event listener to the body element and stop listening\n    // for specific key presses\n    document.body.removeEventListener('focus', this.maintainFocus, true)\n    this.$el.removeEventListener('keydown', this.bindKeypress, true)\n\n    // Ensure the previously focused element (if any) has a `focus` method\n    // before attempting to call it to account for SVG elements\n    // See: https://github.com/KittyGiraudel/a11y-dialog/issues/108\n    this.previouslyFocused?.focus?.()\n\n    return this\n  }\n"}],"expected_accessibility_effect":"Focus returns to the opener button after dialog is closed via Escape, allowing sequential keyboard navigation and meeting WCAG 2.1.1 and 2.4.3 requirements.","functional_risks":["Removing focus listeners before restoring focus could theoretically allow focus to escape if another script moves focus during the brief window, but the dialog is already hidden and inert."],"verification_requirements":["After pressing Escape on the dialog, focus must be on the opener button.","While dialog is open, Tab key must trap focus inside dialog.","Dialog must have aria-hidden='true' when closed."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-814529cf80acd6e2e7e7fce16c167cb0","promptHash":"500e0b5700c02063898ff9d0cc5ea2ae375c2f3fc2322436f2c53e75cb81dba6","schemaVersion":2,"structuredOutput":false,"latencyMs":36731,"usage":{"completion_tokens":7135,"prompt_tokens":13972,"total_tokens":21107,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":5579,"rejected_prediction_tokens":null},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":0,"created_cache_tokens":0,"multimodal_tokens":null},"prompt_cache_hit_tokens":0,"prompt_cache_m