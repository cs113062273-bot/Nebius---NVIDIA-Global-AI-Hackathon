ourney":{"version":1,"id":"govuk-header-nav-exposed-keyboard","title":"Reach the header navigation links as named links on a desktop-width page","goal":"The visible navigation links in the header are exposed to assistive technology as links a keyboard and screen reader user can use","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Tab to the first header navigation link","action":{"kind":"seek","selector":"#nav-apply","maxTabs":24},"assertions":[{"kind":"ax","role":"link","name":"Apply"}]},{"title":"Tab to the next header navigation link","action":{"kind":"press","key":"Tab"},"assertions":[{"kind":"focus","selector":"#nav-renew"},{"kind":"ax","role":"link","name":"Renew a licence"}]}],"success":[{"kind":"ax","role":"link","name":"Apply"},{"kind":"ax","role":"link","name":"Renew a licence"},{"kind":"ax","role":"link","name":"Fishing rules"}],"functional":[{"kind":"attribute","selector":"#menu-button","name":"aria-expanded","value":"false"}],"forbidden":[]},"functionalJourney":{"version":1,"id":"govuk-header-nav-pointer","title":"Follow a header navigation link with a pointer","goal":"Clicking Fishing rules takes the user to that section and the collapsed menu state is unchanged","source":"authored","profile":"pointer","path":"/","steps":[{"title":"Click Fishing rules","action":{"kind":"click","selector":"#nav-rules"},"assertions":[{"kind":"visible","selector":"#rules","value":true}]}],"success":[{"kind":"visible","selector":"#rules","value":true}],"functional":[{"kind":"attribute","selector":"#menu-button","name":"aria-expanded","value":"false"},{"kind":"visible","selector":"#nav-rules","value":true}],"forbidden":[]},"attempts":[{"attempt":1,"startedAt":"2026-10-26T07:19:09.748Z","verified":true,"category":null,"plan":{"root_cause":"The header component incorrectly hides the navigation menu from assistive technology on initial load by setting aria-hidden=true regardless of viewport width, causing navigation links to be inaccessible on desktop.","repair_strategy":"Modify the init method to detect whether the menu button is visible (mobile) or hidden (desktop). If the button is visible (mobile), keep the navigation hidden with aria-hidden=true; if the button is hidden (desktop), ensure the navigation is visible by removing aria-hidden. This aligns the accessibility state with the CSS media query behavior.","edits":[{"path":"src/govuk/components/header/header.js","sha256":"33e331b7a1f44087522e90d1e295dbc0f915c8b8a82e8afd57a794d21fff4424","before":"Header.prototype.init = function () {\n  if (!this.$module || !this.$menuButton || !this.$menu) {\n    return\n  }\n\n  this.syncState(this.$menu.classList.contains('govuk-header__navigation--open'))\n  this.$menuButton.addEventListener('click', this.handleMenuButtonClick.bind(this))\n}","after":"Header.prototype.init = function () {\n  if (!this.$module || !this.$menuButton || !this.$menu) {\n    return\n  }\n\n  // Determine if menu button is visible (i.e., not display:none)\n  var buttonVisible = window.getComputedStyle(this.$menuButton).getPropertyValue('display') !== 'none'\n\n  if (buttonVisible) {\n    // Mobile: menu hidden initially\n    this.$menu.setAttribute('aria-hidden', 'true')\n    this.$menuButton.setAttribute('aria-expanded', 'false')\n  } else {\n    // Desktop: menu visible initially\n    this.$menu.removeAttribute('aria-hidden')\n    this.$menuButton.setAttribute('aria-expanded', 'false')\n  }\n\n  this.$menuButton.addEventListener('click', this.handleMenuButtonClick.bind(this))\n}"}],"expected_accessibility_effect":"Navigation links will be exposed as links to assistive technology on desktop widths, allowing keyboard and screen‑reader users to reach them via Tab.","functional_risks":["If getComputedStyle returns an empty string (e.g., element not yet in document), the visibility check could fail, but init runs after the module is constructed and the button is in the DOM.","The component does not respond to window resize changes; however, the original behavior also lacked resize handling, so risk is unchanged."],"verification_requirements":["On desktop viewport, verify that the navigation ul has no aria-hidden attribute (or aria-hidden='false') and that the links have role='link' and accessible names matching their text content.","On mobile viewport, verify that the navigation ul has aria-hidden='true' and the menu button's aria-expanded toggles correctly when clicked.","Ensure keyboard focus order remains unchanged and that activating the menu button still shows/hides the navigation as expected."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-8e58df2b38b1817783f63525ca629944","promptHash":"1495ca7b54d91b7b1ae109014c86b2447c54fe0dd5fe0ecc6908071ea824f5f4","schemaVersion":2,"structuredOutput":false,"latencyMs":27717,"usage":{"completion_tokens":4630,"prompt_tokens":4664,"total_tokens":9294,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":3918,"rejected_prediction_tokens":null},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":0,"created_cache_tokens":0,"multimodal_tokens":null},"prompt_cache_hit_tokens":0,"prompt_cache_miss_tokens":4664},"pricing":{"prompt":"0.0000003","input_cache_read":"0.00000006","completion":"0.0000009","image":"0","price_per_video_second":"0","request":"0","price_per_minute":"0"},"reservedCreditUsd":0.0341265,"budgetScope":"realbugs-20261025","cacheHit":false,"retries":0,"attemptedCompletions":1,"responseFile":"response-88087d92dffcc174e427fbef02ec368c88498e6340fcd73221155fe42334c101-633.json","requestFile":"request-88087d92dffcc174e427fbef02ec368c88498e6340fcd73221155fe42334c101-633.json"},"patchValidation":{"gitApplyCheck":true,"candidateBytesMatch":true,"contextLines":3},"changes":[{"path":"src/govuk/components/header/header.js","beforeHash":"33e331b7a1f44087522e90d1e295dbc0f915c8b8a82e8afd57a794d21fff4424","afterHash":"bdedc350ad6a0edf8831e06cc46c5e8