+const isInDisabledFieldset = function (node) {
+  // Form controls inside a disabled fieldset are not focusable,
+  // except those in the fieldset's first legend.
+  const fieldset = node.closest('fieldset[disabled]');
+  if (!fieldset) {
+    return false;
+  }
+  const legend = fieldset.querySelector('legend');
+  if (legend && legend.contains(node)) {
+    return false;
+  }
+  return true;
+};
