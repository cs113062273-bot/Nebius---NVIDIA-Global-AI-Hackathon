   $module.addEventListener('click', this.handleClick.bind(this))
+
+  // Handle changes from any radio with the same name (including other modules)
+  var namesWithControls = {}
+  nodeListForEach($inputs, function ($input) {
+    var controls = $input.getAttribute('aria-controls')
+    if (controls) {
+      var name = $input.getAttribute('name')
+      if (name) {
+        namesWithControls[name] = true
+      }
+    }
+  })
+  for (var name in namesWithControls) {
+    document.addEventListener('change', function (event) {
+      var $target = event.target
+      if ($target.getAttribute('type') === 'radio' && $target.getAttribute('name') === name) {
+        // Update all inputs in this module with this name and aria-controls
+        nodeListForEach($inputs, function ($input) {
+          if ($input.getAttribute('type') === 'radio' && $input.getAttribute('name') === name && $input.getAttribute('aria-controls')) {
+            this.setAttributes($input)
+          }
+        }.bind(this))
+      }
+    }.bind(this))
+  }
 }
 
