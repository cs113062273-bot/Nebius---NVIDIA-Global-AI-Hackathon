diff --git a/src/govuk/components/radios/radios.js b/src/govuk/components/radios/radios.js
index 659c970..884d157 100644
--- a/src/govuk/components/radios/radios.js
+++ b/src/govuk/components/radios/radios.js
@@ -34,6 +34,7 @@ Radios.prototype.init = function () {
 
   // Handle events
   $module.addEventListener('click', this.handleClick.bind(this))
+  document.addEventListener('change', this.handleChange.bind(this))
 }
 
 Radios.prototype.setAttributes = function ($input) {
@@ -57,4 +58,30 @@ Radios.prototype.handleClick = function (event) {
   }.bind(this))
 }
 
+Radios.prototype.handleChange = function (event) {
+  var $target = event.target
+  if ($target.tagName !== 'INPUT' || $target.type !== 'radio') {
+    return
+  }
+
+  // Collect names of radios in this module that have aria-controls
+  var relevantNames = []
+  nodeListForEach(this.$inputs, function ($input) {
+    if ($input.getAttribute('aria-controls') && $input.name) {
+      relevantNames.push($input.name)
+    }
+  })
+
+  // If the changed radio shares a name, update all radios in this module
+  if (relevantNames.indexOf($target.name) !== -1) {
+    nodeListForEach(this.$inputs, function ($input) {
+      var isRadio = $input.getAttribute('type') === 'radio'
+      var hasAriaControls = $input.getAttribute('aria-controls')
+      if (isRadio && hasAriaControls) {
+        this.setAttributes($input)
+      }
+    }.bind(this))
+  }
+}
+
 export default Radios
