+    // Move focus to autofocus element after the dialog enters the top layer.
+    // requestAnimationFrame ensures the browser has processed the top-layer change.
+    // Fall back to synchronous focus if rAF callback runs immediately (test env).
+    const focusAutofocus = () => {
+      const autofocusEl = this._element.querySelector('[autofocus]')
+      if (autofocusEl) {
+        autofocusEl.focus()
+      } else {
+        this._element.focus()
+      }
+    }
+    if (typeof requestAnimationFrame === 'function') {
+      requestAnimationFrame(focusAutofocus)
+    } else {
+      focusAutofocus()
+    }
