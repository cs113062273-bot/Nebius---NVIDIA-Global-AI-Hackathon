rsion":1,"id":"bootstrap-tabs-arrow-panel-guard","title":"Tab from the active tab into its panel","goal":"Tab leaves the tab list for the active panel","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the Account tab","action":{"kind":"seek","selector":"#tab-account","maxTabs":24},"assertions":[]},{"title":"Tab into the Account panel","action":{"kind":"press","key":"Tab"},"assertions":[{"kind":"focus","selector":"#pane-account"}]}],"success":[{"kind":"focus","selector":"#pane-account"}],"functional":[{"kind":"attribute","selector":"#tab-account","name":"aria-selected","value":"true"}],"forbidden":[]}],"guardsHash":"324dd74e28df650a2870dce4197366253fc0663c1578872b58011796f3ad310e","attempts":[{"attempt":1,"startedAt":"2026-10-25T16:27:27.495Z","verified":true,"category":null,"plan":{"root_cause":"Arrow key navigation updates the selected tab's aria-selected state and visual styling but does not move keyboard focus to the newly activated tab, causing focus to remain on the page or previous element.","repair_strategy":"Modify the _keydown handler in the tab component to explicitly focus the newly activated tab after calling its show() method.","edits":[{"path":"js/src/tab.js","sha256":"69ca6e1d090610fe209a5b54a151e20b738214aabf1464807c85c17c0e29848c","before":"  _keydown(event) {\n    if (!([ARROW_LEFT_KEY, ARROW_RIGHT_KEY, ARROW_UP_KEY, ARROW_DOWN_KEY].includes(event.key))) {\n      return\n    }\n\n    event.stopPropagation()// stopPropagation/preventDefault both added to support up/down keys without scrolling the page\n    event.preventDefault()\n    const isNext = [ARROW_RIGHT_KEY, ARROW_DOWN_KEY].includes(event.key)\n    const nextActiveElement = getNextActiveElement(this._getChildren().filter(element => !isDisabled(element)), event.target, isNext, true)\n\n    if (nextActiveElement) {\n      Tab.getOrCreateInstance(nextActiveElement).show()\n    }\n  }","after":"  _keydown(event) {\n    if (!([ARROW_LEFT_KEY, ARROW_RIGHT_KEY, ARROW_UP_KEY, ARROW_DOWN_KEY].includes(event.key))) {\n      return\n    }\n\n    event.stopPropagation()// stopPropagation/preventDefault both added to support up/down keys without scrolling the page\n    event.preventDefault()\n    const isNext = [ARROW_RIGHT_KEY, ARROW_DOWN_KEY].includes(event.key)\n    const nextActiveElement = getNextActiveElement(this._getChildren().filter(element => !isDisabled(element)), event.target, isNext, true)\n\n    if (nextActiveElement) {\n      Tab.getOrCreateInstance(nextActiveElement).show()\n      nextActiveElement.focus()\n    }\n  }"}],"expected_accessibility_effect":"ArrowRight and ArrowLeft keys will move focus to the next or previous tab, making the tab list keyboard navigable according to WCAG 2.1.1 and 2.4.3.","functional_risks":["Adding focus() could cause a focus change if show() is used elsewhere without expecting focus movement, but the tab becomes focusable after activation, so risk is low."],"verification_requirements":["After ArrowRight from #tab-account, focus must be on #tab-notifications and its aria-selected must be true.","After a second ArrowRight, focus must be on #tab-billing and its aria-selected must be true.","Clicking a tab should still update selection and panel without unexpected focus changes.","Initial state and keyboard navigation with ArrowLeft/Up/Down should continue to work as expected."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-0d5534d609da0ff7697a5c5587c12f8d","promptHash":"e899d938c67e05e8086007092ae4194554ae88815c1ece036bf962fe9b79d992","schemaVersion":2,"structuredOutput":false,"latencyMs":13521,"usage":{"completion_tokens":2528,"prompt_tokens":9318,"total_tokens":11846,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":1827,"rejected_prediction_tokens":null},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":0,"created_cache_tokens":0,"multimodal_tokens":null},"promp