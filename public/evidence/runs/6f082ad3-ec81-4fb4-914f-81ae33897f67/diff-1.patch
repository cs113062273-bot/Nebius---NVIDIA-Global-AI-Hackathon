diff --git a/js/src/datepicker.ts b/js/src/datepicker.ts
index e71d8df..8d2848b 100644
--- a/js/src/datepicker.ts
+++ b/js/src/datepicker.ts
@@ -167,6 +167,13 @@ class Datepicker extends BaseComponent {
     this._calendar.show()
     this._isShown = true
 
+    // Move focus to the calendar for popup mode
+    const mainElement = this._calendar.context.mainElement
+    if (mainElement) {
+      mainElement.setAttribute('tabindex', '-1')
+      mainElement.focus()
+    }
+
     EventHandler.trigger(this._element, EVENT_SHOWN)
   }
 
@@ -187,6 +194,12 @@ class Datepicker extends BaseComponent {
     this._calendar.hide()
     this._isShown = false
 
+    // Remove tabindex from the main element
+    const mainElement = this._calendar?.context?.mainElement
+    if (mainElement) {
+      mainElement.removeAttribute('tabindex')
+    }
+
     EventHandler.trigger(this._element, EVENT_HIDDEN)
   }
 
