+
+      // ADD OUR LISTENER FOR TAB KEY TO MOVE FOCUS TO THE NEXT FOCUSABLE ELEMENT
+      // Remove any existing listener to avoid duplicates
+      if (this._tabKeyHandler) {
+        this.element.removeEventListener('keydown', this._tabKeyHandler);
+      }
+      this._tabKeyHandler = (e) => {
+        if (e.key === 'Tab') {
+          let next = this.element.nextElementSibling;
+          while (next) {
+            const focusable = 
+              next.tagName.match(/^(input|select|textarea|button|object)$/i) ||
+              (next.hasAttribute('tabindex') && next.tabIndex >= 0);
+            if (focusable && !next.disabled) {
+              try {
+                next.focus();
+              } catch (err) {
+                // ignore and continue
+              }
+              if (document.activeElement === next) {
+                break;
+              }
+            }
+            next = next.nextElementSibling;
+          }
+          e.preventDefault();
+        }
+      };
+      this.element.addEventListener('keydown', this._tabKeyHandler);
     } else {
