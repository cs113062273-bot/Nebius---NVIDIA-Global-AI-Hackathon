n                var current = self.getDate();\n                if (!current) {\n                    return;\n                }\n                if (opts.disableDayFn && opts.disableDayFn(current)) {\n                    safety++;\n                    continue;\n                }\n                return;\n            }\n        };\n\n        switch(e.keyCode){\n            case 13:\n            case 27:\n                if (opts.field) {\n                    opts.field.blur();\n                }\n                break;\n            case 37:\n                skipDisabled('subtract', 1);\n                break;\n            case 38:\n                skipDisabled('subtract', 7);\n                break;\n            case 39:\n                skipDisabled('add', 1);\n                break;\n            case 40:\n                skipDisabled('add', 7);\n                break;\n            case 8:\n            case 46:\n                self.setDate(null);\n                break;\n        }\n    }\n}\n"}],"expected_accessibility_effect":"Keyboard users can reliably navigate only to selectable dates, ensuring arrow keys skip weekends and other disabled days, meeting WCAG 2.1.1 keyboard operability and predictable focus order.","functional_risks":["Potential infinite loop if all dates are disabled (mitigated by 100‑iteration safety limit).","Performance impact if many consecutive disabled days exist (unlikely in typical use).","If minDate or maxDate is disabled, navigation may stop at the boundary and not move further."],"verification_requirements":["ArrowRight from a Friday selects the following Monday (skipping Saturday and Sunday).","ArrowLeft from a Monday selects the previous Friday.","Up/Down arrows skip disabled days when moving by weeks.","Navigation respects minDate and maxDate boundaries.","Mouse selection and direct date input remain functional."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-7c3c