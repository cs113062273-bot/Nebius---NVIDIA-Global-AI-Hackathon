:{"version":1,"id":"historical-dialog-keyboard","title":"Restore focus after closing a real dialog","goal":"Focus returns to the opener","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach notice trigger","action":{"kind":"seek","selector":"#open","maxTabs":24},"assertions":[]},{"title":"Open notice","action":{"kind":"press","key":"Enter"},"assertions":[{"kind":"focus","selector":"#dialog"}]},{"title":"Dismiss notice and return to the opener","action":{"kind":"press","key":"Escape"},"assertions":[{"kind":"focus","selector":"#open"}]}],"success":[{"kind":"focus","selector":"#open"}],"functional":[{"kind":"attribute","selector":"#dialog","name":"aria-hidden","value":"true"}],"forbidden":[]},"functionalJourney":{"version":1,"id":"historical-dialog-pointer","title":"Restore focus after closing a real dialog","goal":"Focus returns to the opener","source":"authored","profile":"pointer","path":"/","steps":[{"title":"Open notice","action":{"kind":"click","selector":"#open"},"assertions":[{"kind":"attribute","selector":"#dialog","name":"aria-hidden","value":null}]},{"title":"Close notice with pointer","action":{"kind":"click","selector":"#close"},"assertions":[{"kind":"attribute","selector":"#dialog","name":"aria-hidden","value":"true"}]}],"success":[{"kind":"attribute","selector":"#dialog","name":"aria-hidden","value":"true"}],"functional":[{"kind":"attribute","selector":"#dialog","name":"aria-hidden","value":"true"}],"forbidden":[]},"attempts":[{"attempt":1,"startedAt":"2026-10-26T05:37:25.697Z","verified":true,"category":null,"plan":{"root_cause":"The focus restoration in hide() triggers a focus event that is intercepted by the still-active maintainFocus listener, which returns focus to the dialog instead of allowing focus to return to the opener.","repair_strategy":"Reorder the hide() method to remove the focus and keydown listeners before calling focus on the previously focused element, preventing the listener from interfering with focus restoration.","edits":[{"path":"src/a11y-dialog.js","sha256":"9dbd1daa87fcac8518db48e4cbb4b0eeea7c30c92a6171ff59cbc895938aaf4c","before":"/**\n   * Hide the dialog element, restore the focus to the previously active\n   * element, stop listening for some specific key presses and fire all\n   * registered callbacks for `hide` event\n   */\n         hide(event        ) {\n    // If the dialog is already closed, abort\n    if (!this.shown) return this\n\n    // Dispatch a `hide` event\n    const hideEvent = this.fire('hide', event)\n\n    // If the event was prevented, do not continue with the normal behavior\n    if (hideEvent.defaultPrevented) return this\n\n    this.shown = false\n    this.$el.setAttribute('aria-hidden', 'true')\n\n    // Ensure the previously focused element (if any) has a `focus` method\n    // before attempting to call it to account for SVG elements\n    // See: https://github.com/KittyGiraudel/a11y-dialog/issues/108\n    this.previouslyFocused?.focus?.()\n\n    // Remove the focus event listener to the body element and stop listening\n    // for specific key presses\n    document.body.removeEventListener('focus', this.maintainFocus, true)\n    this.$el.removeEventListener('keydown', this.bindKeypress, true)\n\n    return this\n  }\n","after":"/**\n   * Hide the dialog element, restore the focus to the previously active\n   * element, stop listening for some specific key presses and fire all\n   * registered callbacks for `hide` event\n   */\n         hide(event        ) {\n    // If the dialog is already closed, abort\n    if (!this.shown) return this\n\n    // Dispatch a `hide` event\n    const hideEvent = this.fire('hide', event)\n\n    // If the event was prevented, do not continue with the normal behavior\n    if (hideEvent.defaultPrevented) return this\n\n    this.shown = false\n    this.$el.setAttribute('aria-hidden', 'true')\n\n    // Remove the focus event listener to the body element and stop listening\n    // for specific key presses\n    document.body.removeEventListener('focus', this.maintainFocus, true)\n    this.$el.removeEventListener('keydown', this.bindKeypress, true)\n\n    // Ensure the previously focused element (if any) has a `focus` method\n    // before attempting to call it to account for SVG elements\n    // See: https://github.com/KittyGiraudel/a11y-dialog/issues/108\n    this.previouslyFocused?.focus?.()\n\n    return this\n  }\n"}],"expected_accessibility_effect":"Focus returns to the opener button after the dialog is dismissed with Escape, satisfying keyboard focus management requirements.","functional_risks":["Removing listeners before focus restoration could theoretically allow a stray key event to be processed, but the dialog is already marked as hidden and aria-hidden=true, so user interaction is suppressed.","If any external code relies on the focus event firing after hide() but before listener removal, that timing changes slightly."],"verification_requirements":["After pressing Escape to close the dialog, focus must be on the opener button (#open).","Dialog must remain invisibly hidden (aria-hidden=true) after close.","While dialog is open, Tab key must trap focus inside dialog.","Escape key must close dialog when open and do nothing when already closed."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-c3ac27e0b98a6fe5e22fc54c664da7d2","promptHash":"fd8734421f70e73a955f9044a2d50695e288aa846440bf80f3586a40e95bda25","schemaVersion":2,"structuredOutput":false,"latencyMs":17887,"usage":{"completion_tokens":3901,"prompt_tokens":14680,"total_tokens":18581,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":2962,"rejected_prediction_tokens":null},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":0,"created_cache_tokens":0,"multimodal_tokens":null},"prompt_cache_hit_tokens":0,"prompt_cache_miss_tokens":14680},"pricing":{"prompt":"0.0000003","input_cache_read":