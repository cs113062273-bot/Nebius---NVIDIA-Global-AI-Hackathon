e)\n        {\n            e = e || window.event;\n\n            if (self.isVisible()) {\n\n                function isValidDate(d) {\n                    if (self._o.minDate && d < self._o.minDate) return false;\n                    if (self._o.maxDate && d > self._o.maxDate) return false;\n                    if (typeof self._o.disableDayFn === 'function' && self._o.disableDayFn(d)) return false;\n                    return true;\n                }\n\n                switch(e.keyCode){\n                    case 13:\n                    case 27:\n                        if (opts.field) {\n                            opts.field.blur();\n                        }\n                        break;\n                    case 37:\n                        var prev = self.getDate();\n                        do {\n                            self.adjustDate('subtract', 1);\n                            var curr = self.getDate();\n                            if (!curr) break;\n                            if (curr.getTime() === prev.getTime()) break;\n                            prev = curr;\n                        } while (!isValidDate(curr));\n                        break;\n                    case 38:\n                        var prev = self.getDate();\n                        do {\n                            self.adjustDate('subtract', 7);\n                            var curr = self.getDate();\n                            if (!curr) break;\n                            if (curr.getTime() === prev.getTime()) break;\n                            prev = curr;\n                        } while (!isValidDate(curr));\n                        break;\n                    case 39:\n                        var prev = self.getDate();\n                        do {\n                            self.adjustDate('add', 1);\n                            var curr = self.getDate();\n                            if (!curr) break;\n                            if (curr.getTime() === prev.getTime()) break;\n                            prev = curr;\n                        } while (!isValidDate(curr));\n                        break;\n                    case 40:\n                        var prev = self.getDate();\n                        do {\n                            self.adjustDate('add', 7);\n                            var curr = self.getDate();\n                            if (!curr) break;\n                            if (curr.getTime() === prev.getTime()) break;\n                            prev = curr;\n                        } while (!isValidDate(curr));\n                        break;\n                    case 8:\n                    case 46:\n                        self.setDate(null);\n                        break;\n                }\n            }\n        };"}],"expected_accessibility_effect":"ArrowRight and ArrowLeft keys will skip over disabled weekend days, ensuring keyboard users can only navigate to selectable dates, improving compliance with WCAG 2.1.1 keyboard operability.","functional_risks":["If all dates within the navigable range are disabled, the loop could become infinite; mitigated by breaking when the date stops changing due to bounds.","Performance impact is negligible as the loop iterates only over consecutive disabled dates (at most a few weeks).","Ensures min/max date boundaries are still honored; navigation will stop at the boundary even if that date is disabled."],"verification_requirements":["Verify that starting from Friday 2026-11-20, pressing ArrowRight results in the field value 2026-11-23 (skipping weekend).","Verify that pressing ArrowLeft from Monday 2026-11-23 results in 2026-11-20.","Verify that ArrowUp/ArrowDown shift by weeks while skipping weekends.","Verify that navigation stops at minDate and maxDate boundaries.","Verify that manual date entry and form submission still respect disableDayFn (validation)."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","request