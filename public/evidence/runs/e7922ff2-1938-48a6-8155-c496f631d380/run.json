{"id":"e7922ff2-1938-48a6-8155-c496f631d380","fixture":"custom-project","mode":"nebius","source":{"kind":"source","name":"Arrow keys in a tab list must skip disabled tabs","originalRoot":".\\benchmarks\\realbugs\\bootstrap-tabs-skip-disabled\\original","scope":"Real upstream bug (https://github.com/twbs/bootstrap/pull/36169) at cca801683dfbc54dc7ae7a6ef6ce4361b071bc36. Blind to the maintainers' fix 5d9500bdfdd02b3b1d91df2be86b1723f517fc52; routing auto."},"state":"VERIFIED","events":[{"state":"CREATED","at":"2026-10-25T18:51:18.764Z"},{"state":"PREPARING","detail":"Clean browser contexts; user-selected static source snapshot","at":"2026-10-25T18:51:18.767Z"},{"state":"BASELINE_RUNNING","detail":"Reproduce task and independent pointer functional baseline","at":"2026-10-25T18:51:18.886Z"},{"state":"FAILURE_CONFIRMED","detail":"Expected state did not occur after action","at":"2026-10-25T18:51:24.141Z"},{"state":"LOCALIZING","detail":"Rank source candidates from selector/name evidence","at":"2026-10-25T18:51:24.143Z"},{"state":"PLANNING_REPAIR","detail":"NVIDIA Nemotron proposes bounded edits via Nebius","at":"2026-10-25T18:51:24.150Z"},{"state":"PATCHING","detail":"Validate allowlist, hashes, unique preimages and change bounds in isolated copy","at":"2026-10-25T18:51:41.430Z"},{"state":"BUILDING","detail":"Validate static JavaScript syntax and HTML structure","at":"2026-10-25T18:51:41.573Z"},{"state":"REPLAYING","detail":"Same frozen journey, fresh browser context","at":"2026-10-25T18:51:41.998Z"},{"state":"VERIFYING","detail":"Deterministic task + functional + oracle + regression gate","at":"2026-10-25T18:51:43.487Z"},{"state":"VERIFIED","detail":"Verified only for the tested journey and conditions","at":"2026-10-25T18:51:43.538Z"}],"journeyHash":"89b1d6ba3097178f82a29f1262262a6014677e4833910f5a1095af74e8dcd27c","functionalJourneyHash":"22460a695874ae8448059f50e5012ce1d0baa1ae5c55f3f305ddb51ff1447e50","journey":{"version":1,"id":"bootstrap-tabs-disabled-keyboard","title":"Arrow past a disabled settings tab","goal":"ArrowRight skips the disabled tab and selects the next enabled one","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the Account tab","action":{"kind":"seek","selector":"#tab-account","maxTabs":24},"assertions":[]},{"title":"Move right past the disabled Notifications tab","action":{"kind":"press","key":"ArrowRight"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"focus","selector":"#tab-billing"}]}],"success":[{"kind":"focus","selector":"#tab-billing"},{"kind":"visible","selector":"#billing-plan","value":true}],"functional":[{"kind":"attribute","selector":"#tab-notifications","name":"aria-selected","value":"false"},{"kind":"visible","selector":"#notify-email","value":false}],"forbidden":[]},"functionalJourney":{"version":1,"id":"bootstrap-tabs-disabled-pointer","title":"Switch settings sections with the mouse","goal":"Clicking a tab shows its panel","source":"authored","profile":"pointer","path":"/","steps":[{"title":"Open Billing","action":{"kind":"click","selector":"#tab-billing"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":true}]},{"title":"Return to Account","action":{"kind":"click","selector":"#tab-account"},"assertions":[{"kind":"attribute","selector":"#tab-account","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#account-name","value":true}]}],"success":[{"kind":"visible","selector":"#account-name","value":true}],"functional":[{"kind":"attribute","selector":"#tab-account","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":false}],"forbidden":[]},"guards":[{"version":1,"id":"bootstrap-tabs-disabled-left-guard","title":"Arrow left wraps to the last tab","goal":"ArrowLeft from the first tab selects Billing","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the Account tab","action":{"kind":"seek","selector":"#tab-account","maxTabs":24},"assertions":[]},{"title":"Wrap left to Billing","action":{"kind":"press","key":"ArrowLeft"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"focus","selector":"#tab-billing"}]}],"success":[{"kind":"focus","selector":"#tab-billing"}],"functional":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":true}],"forbidden":[]}],"guardsHash":"ebea33ab19683c1fe77d44af60b14e7b204f03737fe60c6814a719cad0ec1288","attempts":[{"attempt":1,"startedAt":"2026-10-25T18:51:24.150Z","verified":true,"category":null,"plan":{"root_cause":"The _keydown handler in tab.js does not skip disabled tabs when determining the next active element, causing ArrowRight to attempt focus on a disabled button. Since disabled buttons cannot receive focus, focus remains unchanged and the disabled tab incorrectly receives aria-selected=true.","repair_strategy":"Modify the _keydown method to iterate over candidate next elements returned by getNextActiveElement, skipping any that are disabled via isDisabled, with a loop guard to prevent infinite cycling when all tabs are disabled.","edits":[{"path":"js/src/tab.js","sha256":"7ad4e9f0424d0d4b95bcf399a1639e44cfec200c874382dc7a8b34016a74228f","before":"  _keydown(event) {\n    if (!([ARROW_LEFT_KEY, ARROW_RIGHT_KEY, ARROW_UP_KEY, ARROW_DOWN_KEY].includes(event.key))) {\n      return\n    }\n\n    event.stopPropagation()// stopPropagation/preventDefault both added to support up/down keys without scrolling the page\n    event.preventDefault()\n    const isNext = [ARROW_RIGHT_KEY, ARROW_DOWN_KEY].includes(event.key)\n    const nextActiveElement = getNextActiveElement(this._getChildren(), event.target, isNext, true)\n    Tab.getOrCreateInstance(nextActiveElement).show()\n  }","after":"  _keydown(event) {\n    if (!([ARROW_LEFT_KEY, ARROW_RIGHT_KEY, ARROW_UP_KEY, ARROW_DOWN_KEY].includes(event.key))) {\n      return\n    }\n\n    event.stopPropagation()// stopPropagation/preventDefault both added to support up/down keys without scrolling the page\n    event.preventDefault()\n    const isNext = [ARROW_RIGHT_KEY, ARROW_DOWN_KEY].includes(event.key)\n    let nextActiveElement = getNextActiveElement(this._getChildren(), event.target, isNext, true)\n    // Skip disabled tabs\n    while (isDisabled(nextActiveElement)) {\n      nextActiveElement = getNextActiveElement(this._getChildren(), nextActiveElement, isNext, true)\n      // Prevent infinite loop in case all tabs are disabled\n      if (nextActiveElement === event.target) {\n        break\n      }\n    }\n    Tab.getOrCreateInstance(nextActiveElement).show()\n  }"}],"expected_accessibility_effect":"ArrowRight will now move focus to the next enabled tab (Billing) and set aria-selected=true on that tab, complying with keyboard navigation that skips disabled controls.","functional_risks":["Infinite loop guard prevents hanging if all tabs are disabled.","Change assumes disabling a tab means it should be skipped in arrow navigation; if other code relied on selecting disabled tabs via arrows, that behavior will change.","Ensure that tab activation logic still works correctly for enabled tabs after the skip logic."],"verification_requirements":["Verify that ArrowRight from Account moves focus to Billing and sets aria-selected=true on Billing.","Verify that ArrowLeft from Billing wraps to Account (skipping disabled Notifications).","Confirm that focus does not land on the disabled Notifications tab when using arrow keys.","Ensure that pressing Tab still navigates into tabpanels as expected.","Check that the disabled tab retains its disabled attribute and is not focusable."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-d36becfbf741ec4162ce2023552577f4","promptHash":"c5641fdd5