le":"Arrow past a disabled settings tab","goal":"ArrowRight skips the disabled tab and selects the next enabled one","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the Account tab","action":{"kind":"seek","selector":"#tab-account","maxTabs":24},"assertions":[]},{"title":"Move right past the disabled Notifications tab","action":{"kind":"press","key":"ArrowRight"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"focus","selector":"#tab-billing"}]}],"success":[{"kind":"focus","selector":"#tab-billing"},{"kind":"visible","selector":"#billing-plan","value":true}],"functional":[{"kind":"attribute","selector":"#tab-notifications","name":"aria-selected","value":"false"},{"kind":"visible","selector":"#notify-email","value":false}],"forbidden":[]},"functionalJourney":{"version":1,"id":"bootstrap-tabs-disabled-pointer","title":"Switch settings sections with the mouse","goal":"Clicking a tab shows its panel","source":"authored","profile":"pointer","path":"/","steps":[{"title":"Open Billing","action":{"kind":"click","selector":"#tab-billing"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":true}]},{"title":"Return to Account","action":{"kind":"click","selector":"#tab-account"},"assertions":[{"kind":"attribute","selector":"#tab-account","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#account-name","value":true}]}],"success":[{"kind":"visible","selector":"#account-name","value":true}],"functional":[{"kind":"attribute","selector":"#tab-account","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":false}],"forbidden":[]},"guards":[{"version":1,"id":"bootstrap-tabs-disabled-left-guard","title":"Arrow left wraps to the last tab","goal":"ArrowLeft from the first tab selects Billing","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the Account tab","action":{"kind":"seek","selector":"#tab-account","maxTabs":24},"assertions":[]},{"title":"Wrap left to Billing","action":{"kind":"press","key":"ArrowLeft"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"focus","selector":"#tab-billing"}]}],"success":[{"kind":"focus","selector":"#tab-billing"}],"functional":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":true}],"forbidden":[]}],"guardsHash":"ebea33ab19683c1fe77d44af60b14e7b204f03737fe60c6814a719cad0ec1288","attempts":[{"attempt":1,"startedAt":"2026-10-26T06:28:42.471Z","verified":true,"category":null,"plan":{"root_cause":"The _keydown method in tab.js uses getNextActiveElement which does not skip disabled tabs, causing arrow navigation to move focus to a disabled tab and attempt to activate it.","repair_strategy":"Modify the _keydown method to iterate over the tab list in the arrow direction, skipping disabled tabs, and only activate the next enabled tab (wrapping if necessary). If no enabled tab is found, do nothing.","edits":[{"path":"js/src/tab.js","sha256":"7ad4e9f0424d0d4b95bcf399a1639e44cfec200c874382dc7a8b34016a74228f","before":"  _keydown(event) {\n    if (!([ARROW_LEFT_KEY, ARROW_RIGHT_KEY, ARROW_UP_KEY, ARROW_DOWN_KEY].includes(event.key))) {\n      return\n    }\n\n    event.stopPropagation()// stopPropagation/preventDefault both added to support up/down keys without scrolling the page\n    event.preventDefault()\n    const isNext = [ARROW_RIGHT_KEY, ARROW_DOWN_KEY].includes(event.key)\n    const nextActiveElement = getNextActiveElement(this._getChildren(), event.target, isNext, true)\n    Tab.getOrCreateInstance(nextActiveElement).show()\n  }","after":"  _keydown(event) {\n    if (!([ARROW_LEFT_KEY, ARROW_RIGHT_KEY, ARROW_UP_KEY, ARROW_DOWN_KEY].includes(event.key))) {\n      return\n    }\n\n    event.stopPropagation()// stopPropagation/preventDefault both added to support up/down keys without scrolling the page\n    event.preventDefault()\n    const isNext = [ARROW_RIGHT_KEY, ARROW_DOWN_KEY].includes(event.key)\n    const children = this._getChildren()\n    if (!children.length) {\n      return\n    }\n    let currentIndex = children.indexOf(event.target)\n    if (currentIndex === -1) {\n      return\n    }\n    let nextIndex = currentIndex\n    let found = false\n    do {\n      nextIndex = (nextIndex + (isNext ? 1 : -1) + children.length) % children.length\n      if (!isDisabled(children[nextIndex])) {\n        found = true\n        break\n      }\n    } while (nextIndex !== currentIndex)\n    if (!found) {\n      return\n    }\n    const nextActiveElement = children[nextIndex]\n    Tab.getOrCreateInstance(nextActiveElement).show()\n  }"}],"expected_accessibility_effect":"ArrowRight will move focus to the next enabled tab (Billing) and activate it, skipping disabled tabs as required by ARIA tablist keyboard navigation.","functional_risks":["If all tabs are disabled, arrow keys will no longer activate any tab (no change in behavior).","Change in activation logic may affect any custom listeners that rely on keydown-induced activation.","Vertical arrow keys (Up/Down) also gain the same skipping behavior, which is appropriate for a vertical tablist but could be unexpected if the UI relies on the previous behavior."],"verification_requirements":["Verify that ArrowRight from the Account tab skips the disabled Notifications tab and activates the Billing tab (aria-selected=true, focus moves).","Verify that ArrowLeft from the Billing tab wraps to the Account tab (skipping disabled Notifications if present).","Verify that ArrowRight/Left work normally when no tabs are disabled.","Verify that disabled tabs cannot be activated via arrow keys.","Verify that tab panels update correctly (visibility) when a tab is activated via arrow keys.","Verify that focus is properly managed (no stray focus or focus loss)."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-91eef361057af5482077e63253521659","promptHash":"c5641fdd5165e15a4816628fcff49346e58e1b931550350e84038fe635c457ef","schemaVersion":2,"structuredOutput":false,"latencyMs":26785,"usage":{"completion_tokens":5515,"prompt_tokens":13867,"total_tokens":19382,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":4645,"rejected_prediction_tokens":null},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":0,"created_cache_tokens":0,"multimodal_tokens":null},"prompt_cache_hit_tokens":0,"prompt_cache_miss_tokens":13867},"pricing":{"prompt":"0.0000003","input_cache_read":"0.00000006","completion":"0.0000009","image":"0","price_per_video_second":"0","request":"0","price_per_minute":"0"},"reservedCreditUsd":0.0439326,"budgetScope":"realbugs-20261025","cacheHit":false,"retries":0,"attemptedCompletions":1,"responseFile":"response-067317971ca1ffc0b0331b2a7589dcdb51790e79a68f3f808ef20c69ad31bfbe-559.json","requestFile":"request-067317971ca1ffc0b0331b2a7589dcdb51790e79a68f3f808ef20c69ad31bfbe-559.json"},"patchValidation":{"gitApplyCheck":true,"candidateBytesMatch":true,"contextLines":3},"changes":[{"path":"js/src/tab.js","beforeHash":"7ad4e9f0424d0d4b95bcf399a1639e44cfec200c874382dc7a8b34016a74228f","afterHash":"9796babe9a163469e2d4519c5f878cfeb4625f88cb0e8b8532688858e659273d"}],"diff":"diff-1.patch","verification":{"verdict":"VERIFIED_PASS","reasons":[],"uncertain":[],"newRules":[],"gates":{"keyboard":"VERIFIED_PASS","independentFunctional":"VERIFIED_PASS","functionalOutputUnchanged":true,"regressionGuards":"1/1"},"scope":"Verified only for frozen journey, functional assertions and recorded conditions. Manual review remains required."},"afterDir":"after-1","after":{"verdict":"VERIFIED_PASS","journeyHash":"89b1d6ba3097178f82a29f1262262a6014677e4833910f5a1095af74e8dcd27c","environment":{"viewpo