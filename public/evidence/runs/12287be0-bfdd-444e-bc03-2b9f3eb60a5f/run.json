ourney":{"version":1,"id":"govuk-header-nav-exposed-keyboard","title":"Reach the header navigation links as named links on a desktop-width page","goal":"The visible navigation links in the header are exposed to assistive technology as links a keyboard and screen reader user can use","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Tab to the first header navigation link","action":{"kind":"seek","selector":"#nav-apply","maxTabs":24},"assertions":[{"kind":"ax","role":"link","name":"Apply"}]},{"title":"Tab to the next header navigation link","action":{"kind":"press","key":"Tab"},"assertions":[{"kind":"focus","selector":"#nav-renew"},{"kind":"ax","role":"link","name":"Renew a licence"}]}],"success":[{"kind":"ax","role":"link","name":"Apply"},{"kind":"ax","role":"link","name":"Renew a licence"},{"kind":"ax","role":"link","name":"Fishing rules"}],"functional":[{"kind":"attribute","selector":"#menu-button","name":"aria-expanded","value":"false"}],"forbidden":[]},"functionalJourney":{"version":1,"id":"govuk-header-nav-pointer","title":"Follow a header navigation link with a pointer","goal":"Clicking Fishing rules takes the user to that section and the collapsed menu state is unchanged","source":"authored","profile":"pointer","path":"/","steps":[{"title":"Click Fishing rules","action":{"kind":"click","selector":"#nav-rules"},"assertions":[{"kind":"visible","selector":"#rules","value":true}]}],"success":[{"kind":"visible","selector":"#rules","value":true}],"functional":[{"kind":"attribute","selector":"#menu-button","name":"aria-expanded","value":"false"},{"kind":"visible","selector":"#nav-rules","value":true}],"forbidden":[]},"attempts":[{"attempt":1,"startedAt":"2026-10-26T15:08:14.306Z","verified":true,"category":null,"plan":{"root_cause":"The header component unconditionally sets aria-hidden=true on the navigation menu during initialization, hiding it from assistive technology on desktop widths where the menu is visually visible.","repair_strategy":"Modify syncState to only apply aria-hidden when the menu button is actually visible (offsetParent non‑null), preserving the navigation's accessibility state on desktop while retaining the existing behavior for the mobile menu.","edits":[{"path":"src/govuk/components/header/header.js","sha256":"33e331b7a1f44087522e90d1e295dbc0f915c8b8a82e8afd57a794d21fff4424","before":"/**\n * Sync menu state\n *\n * Sync the menu button class and the accessible state of the menu and the menu\n * button with the visible state of the menu\n *\n * @param {boolean} isVisible Whether the menu is currently visible\n */\nHeader.prototype.syncState = function (isVisible) {\n  this.$menuButton.classList.toggle('govuk-header__menu-button--open', isVisible)\n  this.$menuButton.setAttribute('aria-expanded', isVisible)\n  this.$menu.setAttribute('aria-hidden', !isVisible)\n}","after":"/**\n * Sync menu state\n *\n * Sync the menu button class and the accessible state of the menu and the menu\n * button with the visible state of the menu\n *\n * @param {boolean} isVisible Whether the menu is currently visible\n */\nHeader.prototype.syncState = function (isVisible) {\n  this.$menuButton.classList.toggle('govuk-header__menu-button--open', isVisible)\n  this.$menuButton.setAttribute('aria-expanded', isVisible)\n  if (this.$menuButton.offsetParent) {\n    this.$menu.setAttribute('aria-hidden', !isVisible)\n  }\n}"}],"expected_accessibility_effect":"Navigation links will be exposed in the accessibility tree as links with correct names, allowing keyboard and screen‑reader users to reach them.","functional_risks":["If the menu button becomes visible via other means (e.g., custom styling), aria‑hidden may not be updated correctly.","Changing the conditional logic could affect edge cases where offsetParent is null but the menu is still visible (unlikely)."],"verification_requirements":["After page load at desktop width, inspect the navigation ul and verify it has no aria-hidden attribute (or aria-hidden='false').","Tabbing from the home link should move focus to the 'Apply' link and the accessibility tree should show role link with name 'Apply'.","Resizing to mobile width and opening the menu should still hide/show the navigation correctly and update aria‑hidden appropriately."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-771f7853baf6d517734107cff8eca412","promptHash":"1495ca7b54d91b7b1ae109014c86b2447c54fe0dd5fe0ecc6908071ea824f5f4","schemaVersion":2,"structuredOutput":false,"latencyMs":10674,"usage":{"completion_tokens":2395,"prompt_tokens":4664,"total_tokens":7059,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":1742,"rejected_prediction_tokens":null},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":0,"created_cache_tokens":0,"multimodal_tokens":null},"prompt_cache_hit_tokens":0,"prompt_cache_miss_tokens":4664},"pricing":{"prompt":"0.0000003","input_cache_read":"0.00000006","completion":"0.0000009","image":"0","price_per_video_second":"0","request":"0","price_per_minute":"0"},"reservedCreditUsd":0.0341265,"budgetScope":"realbugs-20261025","cacheHit":false,"retries":0,"attemptedCompletions":1,"responseFile":"response-88087d92dffcc174e427fbef02ec368c88498e6340fcd73221155fe42334c101-1183.json","requestFile":"request-88087d92dffcc174e427fbef02ec368c88498e6340fcd73221155fe42334c101-1183.json"},"patchValidation":{"gitApplyCheck":true,"candidateBytesMatch":true,"contextLines":3},"changes":[{"path":"src/govuk/components/header/header.js","beforeHash":"33e331b7a1f44087522e90d1e295dbc0f915c8b8a82e8afd57a794d21fff4424","afterHash":"1dfb83a261f706a77e1cccb6df51523483868f93a90ef81b62b92dfe39166c93"}],"diff":"diff-1.patch","verification":{"verdict":"VERIFIED_PASS","reasons":[],"uncertain":[],"newRules":[],"gates":{"keyboard":"VERIFIED_PASS","independentFunctional":"VERIFIED_PASS","functionalOutputUnchanged":true},"scope":"Verified only for froz