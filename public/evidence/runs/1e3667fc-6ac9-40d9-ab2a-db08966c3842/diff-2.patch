+        self._getNextSelectableDate = function(date, increment) {
+            var next = new Date(date.getTime());
+            var step = increment > 0 ? 1 : -1;
+            var maxSteps = 366;
+            var steps = 0;
+            while (steps < maxSteps) {
+                next.setTime(next.getTime() + step * 24*60*60*1000);
+                steps++;
+                var isDisabled = false;
+                if (opts.minDate && next < opts.minDate) isDisabled = true;
+                if (opts.maxDate && next > opts.maxDate) isDisabled = true;
+                if (opts.disableWeekends && isWeekend(next)) isDisabled = true;
+                if (opts.disableDayFn && opts.disableDayFn(next)) isDisabled = true;
+                if (!isDisabled) {
+                    return next;
+                }
+            }
+            return date;
+        };
