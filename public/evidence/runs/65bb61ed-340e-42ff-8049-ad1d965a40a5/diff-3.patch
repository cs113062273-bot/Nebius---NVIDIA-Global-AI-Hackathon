diff --git a/src/govuk/components/header/header.js b/src/govuk/components/header/header.js
index 84eb54f..7246487 100644
--- a/src/govuk/components/header/header.js
+++ b/src/govuk/components/header/header.js
@@ -21,8 +21,21 @@ Header.prototype.init = function () {
     return
   }
 
-  this.syncState(this.$menu.classList.contains('govuk-header__navigation--open'))
-  this.$menuButton.addEventListener('click', this.handleMenuButtonClick.bind(this))
+  // Determine if the menu button is visible (i.e., we are in mobile view)
+  var isButtonVisible = window.getComputedStyle(this.$menuButton).display !== 'none';
+
+  // If the button is not visible (desktop), the navigation is always visible
+  // and the button is not part of the interaction, so set aria-expanded=false, aria-hidden=false
+  if (!isButtonVisible) {
+    this.$menuButton.setAttribute('aria-expanded', 'false');
+    this.$menu.setAttribute('aria-hidden', 'false');
+    return;
+  }
+
+  // Mobile view: initialize based on --open class and add click listener
+  var isVisible = this.$menu.classList.contains('govuk-header__navigation--open');
+  this.syncState(isVisible);
+  this.$menuButton.addEventListener('click', this.handleMenuButtonClick.bind(this));
 }
 
