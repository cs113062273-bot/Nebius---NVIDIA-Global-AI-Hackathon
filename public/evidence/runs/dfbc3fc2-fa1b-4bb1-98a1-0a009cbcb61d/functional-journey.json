{
  "version": 1,
  "id": "pikaday-pointer-pick-day",
  "title": "Pick a delivery day with the pointer",
  "goal": "Clicking a day in the calendar fills the delivery day",
  "source": "authored",
  "profile": "pointer",
  "path": "/",
  "steps": [
    {
      "title": "Choose 20 March",
      "action": {
        "kind": "click",
        "selector": ".pika-button[data-pika-month=\"2\"][data-pika-day=\"20\"]"
      },
      "assertions": [
        {
          "kind": "form-data",
          "selector": "#slot-form",
          "name": "delivery",
          "value": [
            "2024-03-20"
          ]
        }
      ]
    },
    {
      "title": "Write a note",
      "action": {
        "kind": "click",
        "selector": "#notes"
      },
      "assertions": []
    },
    {
      "title": "Type the note",
      "action": {
        "kind": "type",
        "text": "Back door"
      },
      "assertions": []
    },
    {
      "title": "Book the slot",
      "action": {
        "kind": "click",
        "selector": "#submit"
      },
      "assertions": [
        {
          "kind": "text",
          "selector": "#status",
          "value": "Booked 2024-03-20"
        }
      ]
    }
  ],
  "success": [
    {
      "kind": "text",
      "selector": "#status",
      "value": "Booked 2024-03-20"
    }
  ],
  "functional": [
    {
      "kind": "form-data",
      "selector": "#slot-form",
      "name": "delivery",
      "value": [
        "2024-03-20"
      ]
    },
    {
      "kind": "form-data",
      "selector": "#slot-form",
      "name": "notes",
      "value": [
        "Back door"
      ]
    }
  ],
  "forbidden": []
}