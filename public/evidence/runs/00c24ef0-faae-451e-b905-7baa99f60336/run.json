ile":"keyboard","path":"/","steps":[{"title":"Reach the summary field","action":{"kind":"seek","selector":"#summary","maxTabs":24},"assertions":[]},{"title":"Type thirty characters","action":{"kind":"type","text":"Map does not load on my phone."},"assertions":[]}],"success":[{"kind":"text","selector":"#summary-group .govuk-character-count__status","value":"You have 0 characters remaining"}],"functional":[{"kind":"form-data","selector":"#report-form","name":"summary","value":["Map does not load on my phone."]}],"forbidden":[]}],"guardsHash":"23d1d1846af860885d8a04d385437eeca509aa47ed4f8e3b55278984415d0578","attempts":[{"attempt":1,"startedAt":"2026-10-26T07:18:49.385Z","verified":true,"category":null,"plan":{"root_cause":"The component removes the maxlength attribute from the wrapper div instead of the textarea, leaving the browser-enforced maxlength on the textarea. This truncates input at the limit and prevents the character-count logic from detecting overflow, so the error message never appears.","repair_strategy":"Change the line that removes the hard limit to target the textarea element ($textarea) rather than the wrapper ($module), allowing JavaScript to manage the limit while removing the browser enforcement.","edits":[{"path":"src/govuk/components/character-count/character-count.js","sha256":"b17688138faafe0e8e1b3b435f890c52c8dc6ca9fbcbb8644f2e93a5125f7b90","before":"  // Remove hard limit if set\n  $module.removeAttribute('maxlength')","after":"  // Remove hard limit if set\n  $textarea.removeAttribute('maxlength')"}],"expected_accessibility_effect":"Users can type beyond the limit and receive a clear notification of excess characters, satisfying WCAG 2.1.1 (keyboard access) and 4.1.2 (name, role, value) as the character count updates correctly for all users, including screen readers.","functional_risks":["Removing maxlength from the textarea could theoretically affect any code that expects the attribute to remain on the wrapper, but no such usage is evident in the provided source.","Fallback behavior for users without JavaScript remains unchanged because the textarea retains its maxlength attribute until the script runs; after script execution the limit is enforced by JavaScript."],"verification_requirements":["After init, the textarea element must not have a maxlength attribute.","Typing more than 30 characters should show the error message 'You have X characters too many' where X is the excess count.","Pasting text longer than the limit should be handled similarly.","The screen‑reader live region (aria‑live polite) must update with the same message on input changes.","Submission of the form should work normally when the value is within limit and show validation UI when over limit."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-af307b40293a75b5bf6700bc69a47fe6","promptHash":"a2baf2497182e3925973a6bd86a09957a66301b506ff9376d3d5d456854710a0","schemaVersion":2,"structuredOutput":false,"latencyMs":13330,"usage":{"completion_tokens":2847,"prompt_tokens":5959,"total_tokens":8806,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":2339,"rejected_prediction_tokens":null},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":0,"created_cache_tokens":0,"multimodal_tokens":null},"prompt_cache_hit_tokens":0,"prompt_cache_miss_tokens":5959},"pricing":{"prompt":"0.0000003","input_cache_read":"0.00000006","completion":"0.0000009","image":"0","price_per_video_second":"0","request":"0","price_per_minute":"0"},"reservedCreditUsd":0.0358983,"budgetScope":"realbugs-20261025","cacheHit":false,"retries":0,"attemptedCompletions":1,"responseFile":"response-a05e15399eae7dcd85a4e02195eb9f266f241ec9f78f23dc3ac91209d5a6308a-632.json","requestFile":"request-a05e15399eae7dcd85a4e02195eb9f266f241ec9f78f23dc3ac91209d5a6308a-632.json"},"patchValidation":{"gitApplyCheck":true,"candidateBytesMatch":true,"contextLines":3},"chan