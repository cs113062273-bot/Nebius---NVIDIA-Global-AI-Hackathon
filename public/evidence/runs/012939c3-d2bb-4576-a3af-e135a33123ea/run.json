le":"Arrow past a disabled settings tab","goal":"ArrowRight skips the disabled tab and selects the next enabled one","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the Account tab","action":{"kind":"seek","selector":"#tab-account","maxTabs":24},"assertions":[]},{"title":"Move right past the disabled Notifications tab","action":{"kind":"press","key":"ArrowRight"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"focus","selector":"#tab-billing"}]}],"success":[{"kind":"focus","selector":"#tab-billing"},{"kind":"visible","selector":"#billing-plan","value":true}],"functional":[{"kind":"attribute","selector":"#tab-notifications","name":"aria-selected","value":"false"},{"kind":"visible","selector":"#notify-email","value":false}],"forbidden":[]},"functionalJourney":{"version":1,"id":"bootstrap-tabs-disabled-pointer","title":"Switch settings sections with the mouse","goal":"Clicking a tab shows its panel","source":"authored","profile":"pointer","path":"/","steps":[{"title":"Open Billing","action":{"kind":"click","selector":"#tab-billing"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":true}]},{"title":"Return to Account","action":{"kind":"click","selector":"#tab-account"},"assertions":[{"kind":"attribute","selector":"#tab-account","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#account-name","value":true}]}],"success":[{"kind":"visible","selector":"#account-name","value":true}],"functional":[{"kind":"attribute","selector":"#tab-account","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":false}],"forbidden":[]},"guards":[{"version":1,"id":"bootstrap-tabs-disabled-left-guard","title":"Arrow left wraps to the last tab","goal":"ArrowLeft from the first tab selects Billing","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the Account tab","action":{"kind":"seek","selector":"#tab-account","maxTabs":24},"assertions":[]},{"title":"Wrap left to Billing","action":{"kind":"press","key":"ArrowLeft"},"assertions":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"focus","selector":"#tab-billing"}]}],"success":[{"kind":"focus","selector":"#tab-billing"}],"functional":[{"kind":"attribute","selector":"#tab-billing","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#billing-plan","value":true}],"forbidden":[]}],"guardsHash":"ebea33ab19683c1fe77d44af60b14e7b204f03737fe60c6814a719cad0ec1288","attempts":[{"attempt":1,"startedAt":"2026-10-26T07:55:01.946Z","verified":true,"category":null,"plan":{"root_cause":"The _keydown method in tab.js uses getNextActiveElement which does not filter out disabled tabs, causing ArrowRight to move focus to a disabled tab instead of skipping to the next enabled one.","repair_strategy":"Modify the _keydown method to repeatedly call getNextActiveElement until the resulting element is not disabled, stopping if we return to the original element to avoid infinite loops.","edits":[{"path":"js/src/tab.js","sha256":"7ad4e9f0424d0d4b95bcf399a1639e44cfec200c874382dc7a8b34016a74228f","before":"  _keydown(event) {\n    if (!([ARROW_LEFT_KEY, ARROW_RIGHT_KEY, ARROW_UP_KEY, ARROW_DOWN_KEY].includes(event.key))) {\n      return\n    }\n\n    event.stopPropagation()// stopPropagation/preventDefault both added to support up/down keys without scrolling the page\n    event.preventDefault()\n    const isNext = [ARROW_RIGHT_KEY, ARROW_DOWN_KEY].includes(event.key)\n    const nextActiveElement = getNextActiveElement(this._getChildren(), event.target, isNext, true)\n    Tab.getOrCreateInstance(nextActiveElement).show()\n  }","after":"  _keydown(event) {\n    if (!([ARROW_LEFT_KEY, ARROW_RIGHT_KEY, ARROW_UP_KEY, ARROW_DOWN_KEY].includes(event.key))) {\n      return\n    }\n\n    event.stopPropagation()// stopPropagation/preventDefault both added to support up/down keys without scrolling the page\n    event.preventDefault()\n    const isNext = [ARROW_RIGHT_KEY, ARROW_DOWN_KEY].includes(event.key)\n    const children = this._getChildren()\n    let nextActiveElement = getNextActiveElement(children, event.target, isNext, true)\n    // Skip disabled tabs\n    while (isDisabled(nextActiveElement) && nextActiveElement !== event.target) {\n      nextActiveElement = getNextActiveElement(children, nextActiveElement, isNext, true)\n    }\n    Tab.getOrCreateInstance(nextActiveElement).show()\n  }"}],"expected_accessibility_effect":"ArrowRight and ArrowLeft keyboard navigation will skip over disabled tabs, moving focus only to enabled tabs, preventing focus on disabled controls and conforming to ARIA tablist practices.","functional_risks":["If all tabs are disabled, the loop would return to the original element and still call show on it (which is disabled but may be unexpected).","Changes to _keydown affect only the tab component; other components using getNextActiveElement are unaffected.","Ensure that disabled tabs retain correct ARIA attributes (aria-selected=false, tabindex=-1) and are not inadvertently activated via other means."],"verification_requirements":["Press ArrowRight from the first tab when the second tab is disabled; focus should move to the third tab and aria-selected should update accordingly.","Press ArrowLeft from the third tab with the second disabled; focus should wrap to the first tab.","Disabled tabs must not receive focus via keyboard navigation and must remain excluded from the tab sequence.","Programmatic activation (tab.show()) and click activation of tabs should continue to work as expected."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-023e481e47fb9a793e9d01b38894801f","promptHash":"49f87eb81bf6934567a267fa6612739c8911bee4d86edbcec537b73f6ee4b529","schemaVersion":2,"structuredOut