ile":"keyboard","path":"/","steps":[{"title":"Reach the summary field","action":{"kind":"seek","selector":"#summary","maxTabs":24},"assertions":[]},{"title":"Type thirty characters","action":{"kind":"type","text":"Map does not load on my phone."},"assertions":[]}],"success":[{"kind":"text","selector":"#summary-group .govuk-character-count__status","value":"You have 0 characters remaining"}],"functional":[{"kind":"form-data","selector":"#report-form","name":"summary","value":["Map does not load on my phone."]}],"forbidden":[]}],"guardsHash":"23d1d1846af860885d8a04d385437eeca509aa47ed4f8e3b55278984415d0578","attempts":[{"attempt":1,"startedAt":"2026-10-26T13:17:15.495Z","verified":true,"category":null,"plan":{"root_cause":"The component incorrectly removes the maxlength attribute from the container div ($module) instead of the textarea ($textarea), leaving the browser-enforced maxlength on the textarea and causing input to be truncated beyond the limit.","repair_strategy":"Change the attribute removal target from $module to $textarea so the textarea's maxlength attribute is removed, allowing full input while the component provides character count feedback via visible and screen-reader messages.","edits":[{"path":"src/govuk/components/character-count/character-count.js","sha256":"b17688138faafe0e8e1b3b435f890c52c8dc6ca9fbcbb8644f2e93a5125f7b90","before":"  // Remove hard limit if set\n  $module.removeAttribute('maxlength')","after":"  // Remove hard limit if set\n  $textarea.removeAttribute('maxlength')"}],"expected_accessibility_effect":"Users can type beyond the limit and receive accurate character count feedback (visible and screen-reader), preserving the full input value. This supports WCAG 2.1.1 (keyboard) and 4.1.2 (name, role, value) by ensuring the textarea's value reflects the complete user input and the character count communicates excess characters.","functional_risks":["If other code depended on the maxlength attribute being removed from the container, removing it from the textarea instead could leave the attribute on the container (which is harmless).","Ensuring the textarea's maxlength removal does not interfere with any custom validation that expects the attribute to remain on the textarea."],"verification_requirements":["Verify that typing more than 30 characters retains the full value in the textarea and the character count shows the excess (e.g., 'You have 4 characters too many').","Verify that typing 30 or fewer characters shows the correct remaining count (e.g., 'You have X characters remaining').","Verify that the screen‑reader live region updates appropriately on input and reflects the same count message.","Verify that form submission includes the complete user‑entered text without truncation."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-ae74a5cffca99fcce16c8ff50f1da6ed","promptHash":"a2baf2497182e3925973a6bd86a09957a66301b506ff9376d3d5d456854710a0","schemaVersion":2,"structuredOutput":false,"latencyMs":22037,"usage":{"completion_tokens":2575,"prompt_tokens":5959,"total_tokens":8534,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":2068,"rejected_prediction_tokens":null},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":0,"created_cache_tokens":0,"multimodal_tokens":null},"prompt_cache_hit_tokens":0,"prompt_cache_miss_tokens":5959},"pricing":{"prompt":"0.0000003","input_cache_read":"0.00000006","completion":"0.0000009","image":"0","price_per_video_second":"0","request":"0","price_per_minute":"0"},"reservedCreditUsd":0.0358983,"budgetScope":"realbugs-20261025","cacheHit":false,"retries":0,"attemptedCompletions":1,"responseFile":"response-a05e15399eae7dcd85a4e02195eb9f266f241ec9f78f23dc3ac91209d5a6308a-1029.json","requestFile":"request-a05e15399eae7dcd85a4e02195eb9f266f241ec9f78f23dc3ac91209d5a6308a-1029.json"},"patchValidation":{"gitApplyCheck":true,"candidateBytesMatch":true,