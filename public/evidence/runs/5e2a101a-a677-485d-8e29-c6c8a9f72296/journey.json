{
  "version": 1,
  "id": "focus-trap-removed-keyboard",
  "title": "Focus stays in the results dialog after Show all removes itself",
  "goal": "Activating a control that removes itself keeps keyboard focus inside the trapped dialog",
  "source": "authored",
  "profile": "keyboard",
  "path": "/",
  "steps": [
    {
      "title": "Reach search results trigger",
      "action": {
        "kind": "seek",
        "selector": "#open",
        "maxTabs": 24
      },
      "assertions": []
    },
    {
      "title": "Open results",
      "action": {
        "kind": "press",
        "key": "Enter"
      },
      "assertions": [
        {
          "kind": "visible",
          "selector": "#results",
          "value": true
        },
        {
          "kind": "focus",
          "selector": "#close"
        }
      ]
    },
    {
      "title": "Move to Show all",
      "action": {
        "kind": "press",
        "key": "Tab"
      },
      "assertions": [
        {
          "kind": "focus",
          "selector": "#more"
        }
      ]
    },
    {
      "title": "Show all results",
      "action": {
        "kind": "press",
        "key": "Enter"
      },
      "assertions": [
        {
          "kind": "text",
          "selector": "#count",
          "value": "4 of 4 results"
        },
        {
          "kind": "visible",
          "selector": "#results:focus-within",
          "value": true
        }
      ]
    }
  ],
  "success": [
    {
      "kind": "visible",
      "selector": "#results:focus-within",
      "value": true
    },
    {
      "kind": "visible",
      "selector": "#results",
      "value": true
    }
  ],
  "functional": [
    {
      "kind": "text",
      "selector": "#count",
      "value": "4 of 4 results"
    }
  ],
  "forbidden": []
}