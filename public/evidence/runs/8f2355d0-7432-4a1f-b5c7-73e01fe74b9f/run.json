ydown event\n   *\n   * - Press right arrow for next tab\n   * - Press left arrow for previous tab\n   *\n   * @private\n   * @param {KeyboardEvent} event - Keydown event\n   */\n  onTabKeydown(event) {\n    switch (event.key) {\n      case 'ArrowLeft':\n      case 'Left':\n        this.activatePreviousTab()\n        event.preventDefault()\n        break\n      case 'ArrowRight':\n      case 'Right':\n        this.activateNextTab()\n        event.preventDefault()\n        break\n    }\n  }"}],"expected_accessibility_effect":"Pressing the down arrow key while focused on a tab will no longer change the selected tab, allowing users to use vertical arrow keys for scrolling within the tab panel without triggering unintended navigation.","functional_risks":["If the tab list is rendered vertically (not the case in this implementation), vertical arrow navigation would be broken. However, the observed DOM and CSS confirm a horizontal tab layout.","Removing vertical arrow handling may affect users who expect vertical movement in a vertical tab list, but the component is used horizontally here and the ARIA APG specifies horizontal arrow keys for horizontal tablists."],"verification_requirements":["Confirm left/right arrow keys still switch focus between adjacent tabs.","Confirm up/down arrow keys do not change the focused tab or selected tab state.","Confirm the tab panel associated with the focused tab remains visible when using vertical arrow keys."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-88c3a6e02c517db56a4aca4029a2656f","promptHash":"170acbec018c3ef97182fc92ec4190135eb939a35c86b4bc1a8f617d48d147a0","schemaVersion":2,"structuredOutput":false,"latencyMs":21248,"usage":{"completion_tokens":4148,"prompt_tokens":10760,"total_tokens":14908,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":3372,"rejected_prediction_tokens":null},"prompt_tokens_details":{