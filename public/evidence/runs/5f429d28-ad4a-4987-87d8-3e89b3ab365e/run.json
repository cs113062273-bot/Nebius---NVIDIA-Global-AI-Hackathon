Input(selectedDates)\n    if (this._isInput) {\n      this._element.value = formattedDate\n    }\n\n    if (this._boundInput) {\n      this._boundInput.value = selectedDates.join(',')\n    }\n\n    if (this._displayElement) {\n      this._displayElement.textContent = formattedDate\n    }\n  }","after":"  protected _syncSelectedDates(selectedDates: string[]): void {\n    const formattedDate = this._formatDateForInput(selectedDates)\n    if (this._isInput) {\n      // Keep ISO format in input for form submission\n      this._element.value = selectedDates[0] || ''\n    }\n\n    if (this._boundInput) {\n      this._boundInput.value = selectedDates.join(',')\n    }\n\n    if (this._displayElement) {\n      this._displayElement.textContent = formattedDate\n    }\n  }"}],"expected_accessibility_effect":"Keyboard users can tab through the date field without altering the saved departure value. The input retains its machine-readable ISO format, ensuring form submission matches the original booking date. Screen readers announce the unchanged date value.","functional_risks":["If selectionMode is 'multiple' or 'multiple-ranged', only the first date is written to the input (but the form only expects a single date)","Bound hidden inputs still receive comma-separated ISO dates (unchanged behavior)","Display elements continue to show locale-formatted dates (unchanged)"],"verification_requirements":["Tab to departure field, press Escape, tab to passengers, type 2, submit → departure=2026-10-22&passengers=2","Select a new date via datepicker → input updates to new ISO date","Form submission with unchanged date preserves original ISO format","Display elements (if any) show locale-formatted dates"]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/Nemotron-3-Ultra-550b-a55b","requestId":"chatcmpl-2e0fa02087d76f5ea8c95330f6841856","promptHash":"991cafdfb868f3b24f542436880cec1001c3762868b71d087f74869795dfe8f6","schemaVersion":2,"structuredOutput":false,"latencyMs":13488,"us