+        // Helper to check if a date is disabled according to picker options
+        self._isDateDisabled = function(date) {
+            var opts = self._o;
+            if (opts.minDate && date < opts.minDate) {
+                return true;
+            }
+            if (opts.maxDate && date > opts.maxDate) {
+                return true;
+            }
+            if (opts.disableWeekends && isWeekend(date)) {
+                return true;
+            }
+            if (opts.disableDayFn && opts.disableDayFn(date)) {
+                return true;
+            }
+            return false;
+        };
