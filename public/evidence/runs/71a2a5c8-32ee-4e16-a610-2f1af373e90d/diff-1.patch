+        // Adjust date by skipping disabled days
+        self._adjustDateSkipDisabled = function(sign, days) {
+            var newDate = self.getDate() || new Date();
+            var increment = (sign === 'add') ? 1 : -1;
+            for (var i = 0; i < days; i++) {
+                do {
+                    newDate = new Date(newDate.valueOf() + increment * 24 * 60 * 60 * 1000);
+                } while (self._isDateDisabled(newDate));
+            }
+            self.setDate(newDate);
+        };
