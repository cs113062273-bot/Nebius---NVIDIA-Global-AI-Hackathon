{
  "version": 1,
  "id": "focus-trap-removed-pointer",
  "title": "Show all results with the pointer",
  "goal": "The dialog opens, lists every result and closes",
  "source": "authored",
  "profile": "pointer",
  "path": "/",
  "steps": [
    {
      "title": "Open results",
      "action": {
        "kind": "click",
        "selector": "#open"
      },
      "assertions": [
        {
          "kind": "visible",
          "selector": "#results",
          "value": true
        }
      ]
    },
    {
      "title": "Show all results",
      "action": {
        "kind": "click",
        "selector": "#more"
      },
      "assertions": [
        {
          "kind": "text",
          "selector": "#count",
          "value": "4 of 4 results"
        }
      ]
    },
    {
      "title": "Close results",
      "action": {
        "kind": "click",
        "selector": "#close"
      },
      "assertions": [
        {
          "kind": "visible",
          "selector": "#results",
          "value": false
        }
      ]
    }
  ],
  "success": [
    {
      "kind": "visible",
      "selector": "#results",
      "value": false
    }
  ],
  "functional": [
    {
      "kind": "text",
      "selector": "#count",
      "value": "4 of 4 results"
    },
    {
      "kind": "visible",
      "selector": "#results",
      "value": false
    }
  ],
  "forbidden": []
}