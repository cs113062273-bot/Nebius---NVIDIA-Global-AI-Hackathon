ow-down-keyboard","title":"Press the down arrow on a tab without being switched to another tab","goal":"The down arrow leaves the Past day tab selected and its panel shown, as only left and right arrows move between horizontal tabs","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the selected tab","action":{"kind":"seek","selector":"a[href='#past-day']","maxTabs":24},"assertions":[]},{"title":"Press the down arrow to read on","action":{"kind":"press","key":"ArrowDown"},"assertions":[{"kind":"visible","selector":"#past-day","value":true}]}],"success":[{"kind":"focus","selector":"a[href='#past-day']"},{"kind":"attribute","selector":"a[href='#past-day']","name":"aria-selected","value":"true"},{"kind":"visible","selector":"#past-day","value":true},{"kind":"visible","selector":"#past-week","value":false}],"functional":[{"kind":"visible","selector":"#past-day","value":true}],"forbidden":[]},"functionalJourney":{"version":1,"id":"govuk-tabs-select-pointer","title":"Choose the Past week tab with a pointer","goal":"Clicking Past week shows its panel and hides Past day","source":"authored","profile":"pointer","path":"/","steps":[{"title":"Choose Past week","action":{"kind":"click","selector":"a[href='#past-week']"},"assertions":[{"kind":"visible","selector":"#past-week","value":true}]}],"success":[{"kind":"visible","selector":"#past-week","value":true}],"functional":[{"kind":"visible","selector":"#past-week","value":true},{"kind":"visible","selector":"#past-day","value":false},{"kind":"attribute","selector":"a[href='#past-week']","name":"aria-selected","value":"true"}],"forbidden":[]},"guards":[{"version":1,"id":"govuk-tabs-arrow-right-keyboard","title":"Move to the next tab with the right arrow","goal":"The right arrow selects and focuses Past week","source":"authored","profile":"keyboard","path":"/","steps":[{"title":"Reach the selected tab","action":{"kind":"seek","selector":"a[href='#past-day']","maxTabs":24},"assertions":[]},{"title":"Press the right arrow","action":{"kind":"press","key":"ArrowRight"},"assertions":[{"kind":"focus","selector":"a[href='#past-week']"}]},{"title":"Press the left arrow","action":{"kind":"press","key":"ArrowLeft"},"assertions":[{"kind":"focus","selector":"a[href='#past-day']"}]}],"success":[{"kind":"visible","selector":"#past-day","value":true}],"functional":[{"kind":"attribute","selector":"a[href='#past-day']","name":"aria-selected","value":"true"}],"forbidden":[]}],"guardsHash":"0ce0e22e662ac05fe3237c0a512eeafe50090389bc92401c2d10d86117a73ce0","attempts":[{"attempt":1,"startedAt":"2026-10-26T14:15:38.996Z","verified":true,"category":null,"plan":{"root_cause":"The Tabs component incorrectly maps the Down and Up arrow keys to activate the next and previous tabs, respectively, in a horizontal tab list where only left and right arrows should change the selected tab.","repair_strategy":"Modify the onTabKeydown method to only respond to left and right arrows (and their equivalents) for activation, and to ignore (but prevent default for) up and down arrows.","edits":[{"path":"packages/govuk-frontend/src/govuk/components/tabs/tabs.js","sha256":"efec2dbc261636f1987a68ade80173d751d99359fe13cc0106084220e96e3698","before":"  /**\n * Handle tab keydown event\n *\n * - Press right/down arrow for next tab\n * - Press left/up arrow for previous tab\n *\n * @private\n * @param {KeyboardEvent} event - Keydown event\n */\n  onTabKeydown(event) {\n    switch (event.key) {\n      // 'Left', 'Right', 'Up' and 'Down' required for Edge 16 support.\n      case 'ArrowLeft':\n      case 'ArrowUp':\n      case 'Left':\n      case 'Up':\n        this.activatePreviousTab()\n        event.preventDefault()\n        break\n      case 'ArrowRight':\n      case 'ArrowDown':\n      case 'Right':\n      case 'Down':\n        this.activateNextTab()\n        event.preventDefault()\n        break\n    }\n  }","after":"  /**\n * Handle tab keydown event\n *\n * - Press right arrow for next tab\n * - Press left arrow for previous tab\n * - Up and down arrows do nothing (prevent default to avoid scrolling)\n *\n * @private\n * @param {KeyboardEvent} event - Keydown event\n */\n  onTabKeydown(event) {\n    switch (event.key) {\n      case 'ArrowLeft':\n      case 'Left':\n        this.activatePreviousTab()\n        event.preventDefault()\n        break\n      case 'ArrowRight':\n      case 'Right':\n        this.activateNextTab()\n        event.preventDefault()\n        break\n      case 'ArrowUp':\n      case 'ArrowDown':\n      case 'Up':\n      case 'Down':\n        event.preventDefault()\n        break\n    }\n  }"}],"expected_accessibility_effect":"Pressing the down arrow on a tab will no longer change the selected tab, allowing users to press down arrow without losing context, which is especially important for screen reader users who might use the down arrow to read the tab panel.","functional_risks":["Changing the key handling might affect users who expect the up and down arrows to move between tabs in a vertical tab list. However, the current implementation is for a horizontal tab list (as seen in the CSS and HTML) and the design pattern for horizontal tabs does not use up/down for navigation. This change aligns with the ARIA Authoring Practices Guide for tabs."],"verification_requirements":["Verify that pressing the left arrow moves to the previous tab.","Verify that pressing the right arrow moves to the next tab.","Verify that pressing the down arrow does not change the selected tab and keeps focus on the current tab.","Verify that pressing the up arrow does not change the selected tab and keeps focus on the current tab.","Verify that the tab panels are shown/hidden appropriately when tabs are changed via left/right arrows.","Verify that the arrow key handling does not cause unexpected scrolling when the up/down arrows are pressed."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-78f591477ef36c55e1815