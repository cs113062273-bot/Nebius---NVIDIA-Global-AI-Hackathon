{
  "version": 1,
  "id": "govuk-radios-channel-pointer",
  "title": "Switch reminder channel with a pointer",
  "goal": "Choosing Email then Text message shows only the mobile number field",
  "source": "authored",
  "profile": "pointer",
  "path": "/",
  "steps": [
    {
      "title": "Choose Email",
      "action": {
        "kind": "click",
        "selector": "#reminder"
      },
      "assertions": [
        {
          "kind": "visible",
          "selector": "#conditional-reminder",
          "value": true
        }
      ]
    },
    {
      "title": "Choose Text message",
      "action": {
        "kind": "click",
        "selector": "#reminder-2"
      },
      "assertions": [
        {
          "kind": "visible",
          "selector": "#conditional-reminder",
          "value": false
        }
      ]
    }
  ],
  "success": [
    {
      "kind": "visible",
      "selector": "#conditional-reminder-2",
      "value": true
    }
  ],
  "functional": [
    {
      "kind": "visible",
      "selector": "#conditional-reminder-2",
      "value": true
    },
    {
      "kind": "visible",
      "selector": "#conditional-reminder",
      "value": false
    },
    {
      "kind": "form-data",
      "selector": "#reminder-form",
      "name": "reminder",
      "value": [
        "text"
      ]
    }
  ],
  "forbidden": []
}