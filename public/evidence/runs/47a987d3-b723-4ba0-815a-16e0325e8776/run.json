ile":"keyboard","path":"/","steps":[{"title":"Reach the summary field","action":{"kind":"seek","selector":"#summary","maxTabs":24},"assertions":[]},{"title":"Type thirty characters","action":{"kind":"type","text":"Map does not load on my phone."},"assertions":[]}],"success":[{"kind":"text","selector":"#summary-group .govuk-character-count__status","value":"You have 0 characters remaining"}],"functional":[{"kind":"form-data","selector":"#report-form","name":"summary","value":["Map does not load on my phone."]}],"forbidden":[]}],"guardsHash":"23d1d1846af860885d8a04d385437eeca509aa47ed4f8e3b55278984415d0578","attempts":[{"attempt":1,"startedAt":"2026-10-26T15:07:52.975Z","verified":true,"category":null,"plan":{"root_cause":"The component only removes the maxlength attribute from its container element, leaving the textarea's native maxlength attribute active. This causes the browser to truncate input before the script can count excess characters, resulting in an incorrect character count and missing error state when the limit is exceeded.","repair_strategy":"Also remove the maxlength attribute from the textarea element in the init method, allowing the script to receive the full input value and correctly display remaining characters and error state when the limit is exceeded.","edits":[{"path":"src/govuk/components/character-count/character-count.js","sha256":"b17688138faafe0e8e1b3b435f890c52c8dc6ca9fbcbb8644f2e93a5125f7b90","before":"  // Remove hard limit if set\n  $module.removeAttribute('maxlength')","after":"  // Remove hard limit if set\n  $module.removeAttribute('maxlength')\n  $textarea.removeAttribute('maxlength')"}],"expected_accessibility_effect":"Users will receive accurate character count feedback, including an error message when the limit is exceeded, via visible text and ARIA live regions. This ensures they are informed of invalid input, satisfying WCAG 2.1.1 (Keyboard), 2.4.3 (Focus Order), and 4.1.2 (Name, Role, Value).","functional_risks":["Potential regression if any downstream code relies on the textarea's maxlength attribute, though the component is intended to replace the native limit with scripted counting.","Ensuring that the hard maxlength remains for noscript fallback, so form submission still respects the limit when JavaScript is disabled."],"verification_requirements":["Verify that typing beyond the limit shows a negative remaining count and error styling on the textarea.","Verify that typing within the limit shows the correct remaining count and no error styling.","Verify that screen‑reader users hear updated messages via the aria‑live region.","Verify that the component continues to work correctly when the word‑count option is used.","Verify that with JavaScript disabled the hard maxlength attribute still prevents over‑limit submission."]},"provenance":{"provider":"Nebius Token Factory","model":"nvidia/nemotron-3-super-120b-a12b","requestId":"chatcmpl-a6b413054846ecb4a8b8100973639b87","promptHash":"a2baf2497182e3925973a6bd86a09957a66301b506ff9376d3d5d456854710a0","schemaVersion":2,"structuredOutput":false,"latencyMs":12678,"usage":{"completion_tokens":2692,"prompt_tokens":5959,"total_tokens":8651,"completion_tokens_details":{"accepted_prediction_tokens":null,"audio_tokens":null,"reasoning_tokens":2176,"rejected_prediction_tokens":null},"prompt_tokens_details":{"audio_tokens":null,"cached_tokens":0,"created_cache_tokens":0,"multimodal_tokens":null},"prompt_cache_hit_tokens":0,"prompt_cache_miss_tokens":5959},"pricing":{"prompt":"0.0000003","input_cache_read":"0.00000006","completion":"0.0000009","image":"0","price_per_video_second":"0","request":"0","price_per_minute":"0"},"reservedCreditUsd":0.0358983,"budgetScope":"realbugs-20261025","cacheHit":false,"retries":0,"attemptedCompletions":1,"responseFile":"response-a05e15399eae7dcd85a4e02195eb9f266f241ec9f78f23dc3ac91209d5a6308a-1182.json","requestFile":"request-a05e15399eae7dcd85a4e02195eb9f266f241ec9f78f23dc3ac91209d5a6308a-1182.json"},"patchValidation"