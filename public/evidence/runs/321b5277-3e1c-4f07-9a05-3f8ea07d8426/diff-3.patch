diff --git a/js/src/datepicker.ts b/js/src/datepicker.ts
index e71d8df..c9a7f51 100644
--- a/js/src/datepicker.ts
+++ b/js/src/datepicker.ts
@@ -240,6 +240,20 @@ class Datepicker extends BaseComponent {
 
     const calendarOptions = this._buildCalendarOptions()
 
+    // Remove aria-haspopup to prevent VCP from blocking Tab key
+    if (this._isInput) {
+      this._element.removeAttribute('aria-haspopup')
+    }
+
+    // Add capturing keydown listener to allow Tab to move focus out when calendar is closed
+    if (this._isInput && !this._isInline) {
+      this._element.addEventListener('keydown', (event: KeyboardEvent) => {
+        if (event.key === 'Tab' && !this._isShown) {
+          event.stopImmediatePropagation()
+        }
+      }, true)
+    }
+
     // Create calendar on the position element (for correct popup positioning)
     // but value updates still go to this._element (the input)
     this._calendar = new Calendar(this._positionElement, calendarOptions)
